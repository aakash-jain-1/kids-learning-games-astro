{
  "name": "kids-learning-games-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro + TypeScript + PWA proof-of-concept migration for kids-learning-games",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:fresh": "bash scripts/dev.sh",
    "stop": "bash scripts/stop-dev.sh",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "test": "ASTRO_TELEMETRY_DISABLED=1 playwright test",
    "test:ui": "ASTRO_TELEMETRY_DISABLED=1 playwright test --ui",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "astro": "^5.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.59.1",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "^5.7.3",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
