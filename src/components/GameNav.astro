---
// Shared top navigation bar. In a full migration this would list all 13 games.
// For the POC we link only to games that exist in this project, plus stubs
// pointing back at the vanilla HTML versions so nothing 404s.

const base = import.meta.env.BASE_URL;
const v = (p: string): string => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
---

<nav class="game-nav" aria-label="Game navigation">
  <a href={v('')}>Home</a>
  <a href={v('games/flashcards-game')}>Flashcards</a>
  <a href={v('games/dinosaurs-game')}>Dinosaurs</a>
  <a href={v('games/solar-system-game')}>Solar System</a>
  <a href={v('games/weather-game')}>Weather</a>
  <a href={v('games/alphabets-game')}>Alphabets</a>
  <a href={v('games/numbers-game')}>Numbers</a>
  <a href={v('games/colors-game')}>Colors</a>
  <a href={v('games/shapes-game')}>Shapes</a>
  <a href={v('games/animals-game')}>Animals</a>
  <a href={v('games/birds-game')}>Birds</a>
  <a href={v('games/hindi-game')}>Hindi</a>
  <a href={v('games/daily-routines-game')}>Routines</a>
  <a href={v('games/woodcutter-story')}>Woodcutter</a>
  <a href={v('games/counting-friends-game')}>Counting</a>
  <a href={v('games/magnitude-comparison-game')}>More</a>
  <a href={v('games/number-friends-game')}>Find</a>
  <a href={v('games/pattern-sequences-game')}>Pattern</a>
  <a class="game-nav-stats" href={v('stats')} aria-label="Parent stats dashboard">📊 Stats</a>
</nav>

<style>
  /* Subtle visual separation: the stats link is parent-facing, not a
     game, so it gets a slightly different tint to read as "tool" rather
     than "another nav target". */
  .game-nav-stats {
    opacity: 0.85;
  }
</style>
