---
// Shared top navigation bar. In a full migration this would list all 13 games.
// For the POC we link only to games that exist in this project, plus stubs
// pointing back at the vanilla HTML versions so nothing 404s.

const base = import.meta.env.BASE_URL;
const v = (p: string): string => `${base}${base.endsWith('/') ? '' : '/'}${p}`;
---

<nav class="game-nav" aria-label="Game navigation">
  <a href={v('')}>Home</a>
  <a href={v('games/flashcards-game')}>Flashcards</a>
  <a href={v('games/dinosaurs-game')}>Dinosaurs</a>
  <a href={v('games/solar-system-game')}>Solar System</a>
  <a href={v('games/weather-game')}>Weather</a>
  <a href={v('games/alphabets-game')}>Alphabets</a>
  <a href={v('games/numbers-game')}>Numbers</a>
  <a href={v('games/colors-game')}>Colors</a>
</nav>
