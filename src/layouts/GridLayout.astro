---
// Shared shell for foundational-set (grid-first) games: alphabets, numbers,
// colors, shapes, animals, birds, hindi-alphabets. Games where the pedagogy
// is "explore a bounded chart of symbols"; contrast with CardMachineLayout
// (reference-catalogue browser).
//
// Provides head meta, PWA wiring, navigation, settings modal, build info,
// and service worker auto-update handling. Each game supplies:
//   * the grid of tiles
//   * the inline detail card
//   * the per-tile data, per-filter labels, and theme color
// via the default slot plus a handful of props.
//
// Design principle: single-column flow at every viewport. Filters → grid →
// detail stacked vertically. This avoids the overlap bug the initial
// two-pane attempt hit at medium widths.

import '@/styles/global.css';
import '@/styles/grid.css';

import BuildInfo from '@/components/BuildInfo.astro';
import GameNav from '@/components/GameNav.astro';
import SettingsModal from '@/components/SettingsModal.astro';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
  ogImage?: string;
  /** Used in service worker updates to construct the canonical page URL */
  pageUrl?: string;
  /** Inline lang attribute */
  lang?: string;
  /**
   * Visual palette for the grid shell. Controls the CSS custom properties
   * defined in `grid.css`. Leave undefined for the default (alphabets /
   * purple) theme.
   */
  theme?:
    | 'alphabets'
    | 'numbers'
    | 'colors'
    | 'shapes'
    | 'animals'
    | 'birds'
    | 'hindi';
}

const {
  title,
  description,
  themeColor = '#4a0e4e',
  ogImage = 'https://aakash-jain-1.github.io/kids-learning-games/assets/icon-512.svg',
  pageUrl,
  lang = 'en',
  theme,
} = Astro.props;

const canonicalUrl =
  pageUrl ??
  new URL(Astro.url.pathname, Astro.site ?? 'https://aakash-jain-1.github.io').href;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⭐</text></svg>"
    />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply saved dark-mode class before paint to avoid FOUC -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('kids_settings_v1');
          if (!raw) return;
          var s = JSON.parse(raw);
          if (s && s.dark) document.documentElement.classList.add('pre-dark');
        } catch (e) {
          /* noop */
        }
      })();
    </script>
  </head>

  <body class="grid" data-theme={theme}>
    <GameNav />

    <slot />

    <SettingsModal />
    <BuildInfo />

    <script>
      // Apply unified settings on every page load (fixes audit H1).
      import { initSettings } from '@/lib/settings';
      initSettings();

      // Clear the pre-dark placeholder class once settings take over.
      document.documentElement.classList.remove('pre-dark');
    </script>

    <script>
      // Service worker auto-update handling via vite-plugin-pwa's virtual module.
      // Fixes audit H4 (cache-name bump gymnastics) and S7 (asset revisioning).
      import { registerSW } from 'virtual:pwa-register';
      registerSW({
        immediate: true,
        onRegisteredSW(_scriptUrl, registration) {
          if (registration) {
            setInterval(() => registration.update(), 60 * 60 * 1000);
          }
        },
      });
    </script>
  </body>
</html>

  <style is:global>
    html.pre-dark body.grid {
      background: #15051a;
      color: #e8d8f0;
    }
    html.pre-dark body.grid[data-theme='alphabets'] {
      background: #15051a;
      color: #e8d8f0;
    }
    html.pre-dark body.grid[data-theme='numbers'] {
      background: #001f3f;
      color: #e0f0ff;
    }
  </style>
