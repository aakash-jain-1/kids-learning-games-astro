---
// Shared shell for classic two-pane games. Mirrors CardMachineLayout:
// head meta, PWA wiring, GameNav, SettingsModal, BuildInfo, service
// worker auto-update. Classic games supply their content via the
// default slot plus a handful of props.
//
// Per-game theming is driven by CSS custom properties in classic.css —
// set the `theme` prop to swap the palette.

import '@/styles/global.css';
import '@/styles/classic.css';

import BuildInfo from '@/components/BuildInfo.astro';
import GameNav from '@/components/GameNav.astro';
import SettingsModal from '@/components/SettingsModal.astro';

interface Props {
  title: string;
  description: string;
  themeColor?: string;
  ogImage?: string;
  /** Used in service worker updates to construct the canonical page URL */
  pageUrl?: string;
  /** Inline lang attribute */
  lang?: string;
  /**
   * Visual palette for the classic shell. Controls the CSS custom
   * properties defined in `classic.css`. New themes are added as
   * `body.classic[data-theme='X']` blocks in that file.
   */
  theme?: 'alphabets' | 'numbers' | 'colors' | 'shapes' | 'animals' | 'birds' | 'hindi';
}

const {
  title,
  description,
  themeColor = '#667eea',
  ogImage = 'https://aakash-jain-1.github.io/kids-learning-games/assets/icon-512.svg',
  pageUrl,
  lang = 'en',
  theme,
} = Astro.props;

const canonicalUrl =
  pageUrl ??
  new URL(Astro.url.pathname, Astro.site ?? 'https://aakash-jain-1.github.io').href;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={description} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🌟</text></svg>"
    />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('kids_settings_v1');
          if (!raw) return;
          var s = JSON.parse(raw);
          if (s && s.dark) document.documentElement.classList.add('pre-dark');
        } catch (e) {
          /* noop */
        }
      })();
    </script>
  </head>

  <body class="classic" data-theme={theme}>
    <GameNav />

    <slot />

    <SettingsModal />
    <BuildInfo />

    <script>
      import { initSettings } from '@/lib/settings';
      initSettings();
      document.documentElement.classList.remove('pre-dark');
    </script>

    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({
        immediate: true,
        onRegisteredSW(_scriptUrl, registration) {
          if (registration) {
            setInterval(() => registration.update(), 60 * 60 * 1000);
          }
        },
      });
    </script>
  </body>
</html>

<style is:global>
  html.pre-dark body.classic {
    background: #1a1a2e;
    color: #e0e0ff;
  }
</style>
