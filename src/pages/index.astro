---
import '@/styles/global.css';
import BuildInfo from '@/components/BuildInfo.astro';
import SettingsModal from '@/components/SettingsModal.astro';

const base = import.meta.env.BASE_URL;
const href = (p: string): string => `${base}${base.endsWith('/') ? '' : '/'}${p}`;

const ogImage = 'https://aakash-jain-1.github.io/kids-learning-games/assets/icon-512.svg';

const games = [
  {
    href: href('games/flashcards-game'),
    emoji: '🃏',
    title: 'Flashcards',
    desc: '14 decks, 280+ cards — stress-testing the shared card-machine layout.',
    ready: true,
  },
  {
    href: href('games/dinosaurs-game'),
    emoji: '🦕',
    title: 'Dinosaurs',
    desc: 'Discover 15 prehistoric creatures with diet filtering.',
    ready: true,
  },
  {
    href: href('games/solar-system-game'),
    emoji: '🪐',
    title: 'Solar System',
    desc: 'Explore 11 space objects — pure-CSS planet art, no images.',
    ready: true,
  },
  {
    href: href('games/weather-game'),
    emoji: '🌦️',
    title: 'Weather',
    desc: '20 types of weather and seasons — first card-machine game with full image decks.',
    ready: true,
  },
  {
    href: href('games/alphabets-game'),
    emoji: '🔤',
    title: 'Alphabets',
    desc: 'A–Z grid with vowel/consonant filter, pictures, facts — first GridLayout game.',
    ready: true,
  },
  {
    href: href('games/numbers-game'),
    emoji: '🔢',
    title: 'Numbers',
    desc: '1–10 tiles with concrete count-objects, group filter — second GridLayout game.',
    ready: true,
  },
  {
    href: href('games/colors-game'),
    emoji: '🎨',
    title: 'Colors',
    desc: '12 colour swatches with a CSS shape gallery, warm/cool/neutral filter — third GridLayout game.',
    ready: true,
  },
  {
    href: href('games/shapes-game'),
    emoji: '🟪',
    title: 'Shapes',
    desc: '14 shape tiles drawn in pure CSS, round/basic/special filter — fourth GridLayout game.',
    ready: true,
  },
  {
    href: href('games/animals-game'),
    emoji: '🐾',
    title: 'Animals',
    desc: '37 animals with emoji tiles, Fluent UI 3D portraits, sounds, and a 5-group filter — fifth GridLayout game.',
    ready: true,
  },
  {
    href: href('games/birds-game'),
    emoji: '🦜',
    title: 'Birds',
    desc: '15 birds with emoji tiles, Fluent UI 3D portraits, calls, and a 5-group filter — sixth GridLayout game.',
    ready: true,
  },
  {
    href: href('games/hindi-game'),
    emoji: '🇮🇳',
    title: 'Hindi',
    desc: '48 Devanagari letters (12 vowels + 36 consonants) with example words, transliteration, pictures, and a vowel/consonant filter — seventh GridLayout game.',
    ready: true,
  },
  {
    href: href('games/daily-routines-game'),
    emoji: '🌅',
    title: 'Daily Routines',
    desc: '10 illustrated scenes from sunrise to bedtime + an 8-question comprehension quiz — first StoryLayout game.',
    ready: true,
  },
  {
    href: href('games/woodcutter-story'),
    emoji: '🪓',
    title: 'Woodcutter',
    desc: 'The Honest Woodcutter — animated single hero scene, 4-paragraph tale, moral panel, and a 6-question quiz on honesty — second StoryLayout game.',
    ready: true,
  },
  {
    href: href('games/counting-friends-game'),
    emoji: '🧮',
    title: 'Counting Friends',
    desc: 'Gentle counting-and-addition for ages 3–4. Two groups of friendly objects, audio narration, no scoring, no failures — first preschool-math game.',
    ready: true,
  },
  {
    href: href('games/magnitude-comparison-game'),
    emoji: '🔍',
    title: 'More Friends',
    desc: 'Companion to Counting Friends — "which side has more?" magnitude comparison for ages 3–4. Tap the bigger group, errorless guided count on miss — second preschool-math game.',
    ready: true,
  },
  {
    href: href('games/number-friends-game'),
    emoji: '🔢',
    title: 'Number Friends',
    desc: 'A numeral appears at the top — tap the group of friendly objects that has that many. Numeral recognition for ages 3–4, errorless guided count on miss — third preschool-math game completing the cardinality triad.',
    ready: true,
  },
  {
    href: href('games/pattern-sequences-game'),
    emoji: '🎨',
    title: 'Pattern Sequences',
    desc: 'What comes next? Five colored circles plus a "?" slot — tap the option that fits the pattern. AB / AAB / ABB / ABC patterns for ages 3–4 — fourth preschool-math game, sister to the cardinality triad.',
    ready: true,
  },
  {
    href: href('games/number-bond-pop-game'),
    emoji: '🎈',
    title: 'Number Bond Pop',
    desc: 'How many more to make 5? Some friends are already here — tap the bunch that fills the empty spaces and watch them pop in. Concrete number bonds for ages 3–4, errorless guided count on miss — fifth preschool-math game, completing the early-math arc.',
    ready: true,
  },
  {
    href: href('games/letter-friends-game'),
    emoji: '🔤',
    title: 'Letter Friends',
    desc: 'Find the letter! A target uppercase letter appears with its picture mnemonic ("A is for Apple") — tap the matching tile from three. SATPIN-tiered progression covers all 26 letters across sessions, errorless guided narration on miss — first preschool-literacy game, sister to Number Friends.',
    ready: true,
  },
  {
    href: href('games/sound-friends-game'),
    emoji: '🔊',
    title: 'Sound Friends',
    desc: 'What does it start with? A picture appears ("apple") — tap the letter its name starts with from three plain letter tiles. Beginning-sound phonics with combined name+sound narration ("A says ah"), SATPIN-tiered across sessions, errorless guided narration on miss — second preschool-literacy game, sister to Letter Friends.',
    ready: true,
  },
  {
    href: href('games/sorting-friends-game'),
    emoji: '🧺',
    title: 'Sorting Friends',
    desc: 'Find all the friends that belong! A category appears ("things that live in the sea") — tap every picture in the tray that fits and watch them collect. Single-attribute sorting by habitat, kind, and size for ages 3–4, errorless guided correction on a wrong tap — first preschool-cognitive game.',
    ready: true,
  },
  {
    href: href('games/week-friends-game'),
    emoji: '📅',
    title: 'Week Friends',
    desc: 'What day comes next? A run of days appears ("Sunday, Monday…") with a "?" — tap the day that comes next. Sunday-first like the days-of-the-week song, errorless guided "let\'s sing the days" reveal on a miss — second preschool-cognitive game, sister to Sorting Friends.',
    ready: true,
  },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#667eea" />
    <meta name="description" content="Astro POC home — proof-of-concept migration of kids-learning-games." />
    <title>Kids Learning Games — Astro POC</title>

    <meta property="og:title" content="Kids Learning Games — Astro POC" />
    <meta property="og:description" content="Astro POC home — proof-of-concept migration of kids-learning-games." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kids Learning Games — Astro POC" />
    <meta name="twitter:description" content="Astro POC home — proof-of-concept migration of kids-learning-games." />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⭐</text></svg>"
    />

    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('kids_settings_v1');
          if (!raw) return;
          var s = JSON.parse(raw);
          if (s && s.dark) document.documentElement.classList.add('pre-dark');
        } catch (e) {
          /* noop */
        }
      })();
    </script>
  </head>

  <body>
    <header class="home-hero">
      <h1>Kids Learning Games</h1>
      <p class="tagline">Astro + TypeScript + PWA — proof of concept</p>
      <button class="ctrl-pill" id="btnSettings" type="button" aria-label="Open settings">
        ⚙️ Settings
      </button>
    </header>

    <main class="home-grid">
      {
        games.map((g) => (
          <a
            class={`home-card${g.ready ? '' : ' disabled'}`}
            href={g.href}
            aria-disabled={g.ready ? undefined : 'true'}
          >
            <span class="home-emoji" aria-hidden="true">{g.emoji}</span>
            <span class="home-title">{g.title}</span>
            <span class="home-desc">{g.desc}</span>
            {!g.ready && <span class="home-badge">coming soon</span>}
          </a>
        ))
      }
    </main>

    {/* Parent-facing stats link sits *below* the grid, not in it — it's
        a tool for adults reviewing progress, not another game to play. */}
    <p class="home-stats-link">
      <a href={href('stats')}>📊 View parent stats →</a>
    </p>

    <SettingsModal />
    <BuildInfo />

    <script>
      import { initSettings } from '@/lib/settings';
      initSettings();
      document.documentElement.classList.remove('pre-dark');

      document.getElementById('btnSettings')?.addEventListener('click', () => {
        (window as unknown as { openSettings?: () => void }).openSettings?.();
      });
    </script>

    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>

    <style is:global>
      html.pre-dark body {
        background: #1a1a2e;
        color: #e8e4ff;
      }

      body {
        min-height: 100dvh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 32px 20px 80px;
      }

      body.dark-mode {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: #e8e4ff;
      }

      .home-hero {
        max-width: 960px;
        margin: 0 auto 32px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .home-hero h1 {
        font-size: clamp(2em, 5vw, 3.2em);
        margin: 0;
        letter-spacing: 1px;
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
      }

      .home-hero .tagline {
        opacity: 0.85;
        font-size: 1em;
      }

      .home-grid {
        max-width: 960px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
      }

      .home-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding: 28px 20px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #fff;
        text-decoration: none;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
      }

      .home-card:hover:not(.disabled) {
        transform: translateY(-4px);
        background: rgba(255, 255, 255, 0.18);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
      }

      .home-card.disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .home-emoji {
        font-size: 2.6em;
        line-height: 1;
      }

      .home-title {
        font-weight: bold;
        font-size: 1.2em;
      }

      .home-desc {
        font-size: 0.85em;
        opacity: 0.85;
        line-height: 1.45;
      }

      .home-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        font-size: 0.6em;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 3px 8px;
        border-radius: 50px;
        background: rgba(0, 0, 0, 0.35);
      }

      .home-stats-link {
        max-width: 960px;
        margin: 28px auto 0;
        text-align: center;
        opacity: 0.78;
        font-size: 0.92em;
      }

      .home-stats-link a {
        color: inherit;
        text-decoration: none;
        padding: 6px 14px;
        border-radius: 50px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.18);
        transition: background 0.18s, opacity 0.18s;
      }

      .home-stats-link a:hover {
        background: rgba(255, 255, 255, 0.16);
        opacity: 1;
      }
    </style>
  </body>
</html>
