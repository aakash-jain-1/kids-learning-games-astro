---
/**
 * Parent-facing stats dashboard (T6, 2026-05-20).
 *
 * Lives at `/stats` — a single page that shows one card per game,
 * organised by family (preschool-math / story / card-set / card-pure).
 * The card content comes from `src/data/stats-registry.ts` so adding a
 * 17th game is a one-entry edit.
 *
 * The page is **additive** to the per-game `alert(...)` Stats buttons
 * (which still work and are still useful for "quick check while my kid
 * is playing this specific game"). `/stats` is the cross-game
 * aggregation view — at-a-glance "what's been played, what's been
 * mastered, what hasn't been touched yet".
 *
 * SSR strategy: render the zero-state values (since `localStorage` is
 * undefined on the server, every `read()` returns zero / "never").
 * The hydrating script then re-runs `entry.read()` and patches the DOM
 * with real values. For first-time visitors there is no flicker (zero
 * is the correct value); returning parents see a brief flash of zero
 * before the real numbers appear, which matches how the in-page Stats
 * alerts already work today.
 */
import '@/styles/global.css';
import BuildInfo from '@/components/BuildInfo.astro';
import SettingsModal from '@/components/SettingsModal.astro';
import GameNav from '@/components/GameNav.astro';
import {
  STATS_REGISTRY,
  FAMILY_LABELS,
  FAMILY_COLORS,
  getActivityByFamily,
  type StatsFamily,
  type StatsRegistryEntry,
} from '@/data/stats-registry';
import { weekdayShort } from '@/lib/retention';

const base = import.meta.env.BASE_URL;
const href = (p: string): string => `${base}${base.endsWith('/') ? '' : '/'}${p}`;

// Group the registry by family while preserving insertion order so the
// page render order matches the array order in stats-registry.ts.
//
// `'preschool-literacy'` sits next to `'preschool-math'` (rather than
// at the end) so the parent's eye groups the preschool work
// together — both are 3yo-targeted, both share the
// `{ sessions, rounds, correctFirstTry, lastPlayed }` shape, and a
// parent reading the dashboard wants to see "math + literacy" as a
// pair rather than scattered across the page.
const FAMILY_ORDER: readonly StatsFamily[] = [
  'preschool-math',
  'preschool-literacy',
  'preschool-cognitive',
  'preschool-social',
  'story',
  'card-set',
  'card-pure',
];

const entriesByFamily: Record<StatsFamily, StatsRegistryEntry[]> = {
  'preschool-math': [],
  'preschool-literacy': [],
  'preschool-cognitive': [],
  'preschool-social': [],
  story: [],
  'card-set': [],
  'card-pure': [],
};
for (const entry of STATS_REGISTRY) {
  entriesByFamily[entry.family].push(entry);
}

// SSR shape for the 7-day activity panel: 7 days, all family
// counts at 0. The hydrating script replaces this with real data
// from `kids_play_history_v1` once `localStorage` is available.
// Returning the array here (rather than just rendering 7 fixed
// elements) keeps the panel SSR-correct even on the server (where
// `getPlayHistory()` returns `{}` and every day's perFamily is 0).
const activityDays = getActivityByFamily(7);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#667eea" />
    <meta
      name="description"
      content="Parent-facing stats dashboard for Kids Learning Games — at-a-glance progress across every game (sessions played, first-try rate, learned-set, quiz best score)."
    />
    <title>Parent Stats — Kids Learning Games</title>

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>"
    />

    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('kids_settings_v1');
          if (!raw) return;
          var s = JSON.parse(raw);
          if (s && s.dark) document.documentElement.classList.add('pre-dark');
        } catch (e) {
          /* noop */
        }
      })();
    </script>
  </head>

  <body class="stats-page">
    <header class="stats-hero">
      <h1>📊 Parent Stats</h1>
      <p class="tagline">
        At-a-glance progress across every game. Tap a card title to open the game,
        or "Reset" to clear that game's stats on this device.
      </p>
      <div class="stats-actions">
        <a class="ctrl-pill" href={href('')}>🏠 Home</a>
        <button class="ctrl-pill" id="btnSettings" type="button" aria-label="Open settings">
          ⚙️ Settings
        </button>
        <button
          class="ctrl-pill ctrl-danger"
          id="btnResetAll"
          type="button"
          aria-label="Reset stats for every game"
        >
          🗑️ Reset everything
        </button>
      </div>
    </header>

    <GameNav />

    <main class="stats-main">
      <section class="stats-activity" id="statsActivity" aria-label="7-day play activity">
        <header class="stats-activity-head">
          <h2 class="stats-activity-title">📅 7-day activity</h2>
          <p class="stats-activity-sub">
            Did your child come back this week? Each dot is one game family that
            saw any play that day.
          </p>
        </header>

        <ol class="stats-activity-grid" id="statsActivityGrid">
          {
            activityDays.map((day) => (
              <li class="stats-activity-day" data-date={day.date}>
                <div class="stats-activity-dots" data-dots>
                  {FAMILY_ORDER.map((family) => (
                    <span
                      class={`stats-activity-dot ${day.perFamily[family] > 0 ? 'is-active' : ''}`}
                      style={`--family-color: ${FAMILY_COLORS[family]};`}
                      data-family={family}
                      title={`${FAMILY_LABELS[family]} — ${day.perFamily[family]} game(s) played`}
                    />
                  ))}
                </div>
                <div class="stats-activity-day-label">
                  {weekdayShort(day.date)}
                </div>
                <div class="stats-activity-day-date">
                  {day.date.slice(5)}
                </div>
              </li>
            ))
          }
        </ol>

        <ul class="stats-activity-legend" aria-label="Family colour legend">
          {
            FAMILY_ORDER.map((family) => (
              <li class="stats-activity-legend-item">
                <span
                  class="stats-activity-legend-swatch"
                  style={`--family-color: ${FAMILY_COLORS[family]};`}
                  aria-hidden="true"
                />
                <span class="stats-activity-legend-label">{FAMILY_LABELS[family]}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        FAMILY_ORDER.map((family) => {
          const entries = entriesByFamily[family];
          if (entries.length === 0) return null;
          return (
            <section class={`stats-section family-${family}`} data-family={family}>
              <h2 class="stats-section-title">{FAMILY_LABELS[family]}</h2>
              <div class="stats-grid">
                {entries.map((entry) => {
                  // SSR shape: zero-state metric rows, real labels and emoji.
                  const rows = entry.read();
                  return (
                    <article
                      class="stats-card"
                      data-game-id={entry.id}
                      data-family={entry.family}
                    >
                      <header class="stats-card-head">
                        <a class="stats-card-title" href={href(entry.hrefPath)}>
                          <span class="stats-card-emoji" aria-hidden="true">{entry.emoji}</span>
                          <span class="stats-card-name">{entry.title}</span>
                          <span class="stats-card-arrow" aria-hidden="true">→</span>
                        </a>
                        <span class="stats-card-empty" data-empty-badge hidden>
                          No plays yet
                        </span>
                      </header>
                      <ul class="stats-card-rows" data-rows>
                        {rows.map((row, i) => (
                          <li class="stats-row">
                            <span class="stats-row-emoji" aria-hidden="true">{row.emoji}</span>
                            <span class="stats-row-label">{row.label}</span>
                            <span class="stats-row-value" data-value-index={i}>{row.value}</span>
                          </li>
                        ))}
                      </ul>
                      <button
                        class="stats-reset"
                        type="button"
                        data-reset
                        aria-label={`Reset stats for ${entry.title}`}
                      >
                        🗑️ Reset
                      </button>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })
      }
    </main>

    <SettingsModal />
    <BuildInfo />

    <script>
      import { initSettings } from '@/lib/settings';
      import {
        STATS_REGISTRY,
        getActivityByFamily,
      } from '@/data/stats-registry';
      import { clearPlayHistory } from '@/lib/retention';

      initSettings();
      document.documentElement.classList.remove('pre-dark');

      // ─── Settings modal trigger ──────────────────────────────────────
      document.getElementById('btnSettings')?.addEventListener('click', () => {
        (window as unknown as { openSettings?: () => void }).openSettings?.();
      });

      // ─── Per-card hydration ──────────────────────────────────────────
      // Walk each card, ask its registry entry for fresh metric rows,
      // and patch the value spans + empty-state badge. SSR already
      // populated zero-state values + correct labels, so this is a
      // pure value swap (no DOM rebuild → no layout shift).
      const REGISTRY_BY_ID = new Map(STATS_REGISTRY.map((e) => [e.id, e]));

      const renderCard = (card: HTMLElement): void => {
        const id = card.dataset.gameId;
        if (!id) return;
        const entry = REGISTRY_BY_ID.get(id);
        if (!entry) return;

        const rows = entry.read();
        const valueEls = card.querySelectorAll<HTMLElement>('[data-value-index]');
        valueEls.forEach((el) => {
          const i = Number(el.dataset.valueIndex);
          const row = rows[i];
          if (row) el.textContent = row.value;
        });

        const empty = card.querySelector<HTMLElement>('[data-empty-badge]');
        if (empty) empty.hidden = entry.hasData();
        card.classList.toggle('is-empty', !entry.hasData());
      };

      const allCards = document.querySelectorAll<HTMLElement>('.stats-card');
      allCards.forEach(renderCard);

      // ─── Activity panel hydration ────────────────────────────────────
      // SSR rendered all 7 day cells with `is-active = false` (because
      // `localStorage` is undefined on the server). Re-run the projector
      // on the client and toggle the `.is-active` class on each dot
      // based on real per-family activity. No DOM rebuild — pure class
      // toggle, no layout shift.
      const FAMILY_ORDER_JS = [
        'preschool-math',
        'preschool-literacy',
        'preschool-cognitive',
        'preschool-social',
        'story',
        'card-set',
        'card-pure',
      ] as const;
      const renderActivity = (): void => {
        const days = getActivityByFamily(7);
        const grid = document.getElementById('statsActivityGrid');
        if (!grid) return;
        const dayCells = grid.querySelectorAll<HTMLElement>('.stats-activity-day');
        dayCells.forEach((cell, i) => {
          const day = days[i];
          if (!day) return;
          // Update the date attribute in case the user crosses midnight
          // mid-session (rare but free to handle).
          cell.dataset.date = day.date;
          const dots = cell.querySelectorAll<HTMLElement>('.stats-activity-dot');
          dots.forEach((dot, j) => {
            const family = FAMILY_ORDER_JS[j];
            if (!family) return;
            const count = day.perFamily[family];
            dot.classList.toggle('is-active', count > 0);
            dot.title = `${family} — ${count} game(s) played`;
          });
        });
      };
      renderActivity();

      // ─── Per-card reset wiring ───────────────────────────────────────
      allCards.forEach((card) => {
        const btn = card.querySelector<HTMLButtonElement>('[data-reset]');
        if (!btn) return;
        const id = card.dataset.gameId ?? '';
        const entry = REGISTRY_BY_ID.get(id);
        if (!entry) return;

        btn.addEventListener('click', () => {
          const ok = window.confirm(
            `Reset stats for "${entry.title}"? This clears progress for this game on this device only.`,
          );
          if (!ok) return;
          entry.clear();
          renderCard(card);
        });
      });

      // ─── Reset-everything button ─────────────────────────────────────
      document.getElementById('btnResetAll')?.addEventListener('click', () => {
        const ok = window.confirm(
          'Reset stats for ALL games? This clears progress for every game on this device only.',
        );
        if (!ok) return;
        STATS_REGISTRY.forEach((e) => {
          e.clear();
        });
        // Per-card `clear()` does NOT remove the sitewide play
        // history (see rationale in `@/lib/retention`); the
        // "Reset everything" button is the one place we wipe
        // both the per-card schemas AND the activity calendar.
        clearPlayHistory();
        allCards.forEach(renderCard);
        renderActivity();
      });
    </script>

    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>

    <style is:global>
      /* FOUC-safe pre-paint background — applied by the inline <head>
         script before any deferred CSS loads. Mirrors the same pattern
         used by index.astro / 404.astro / every game layout. */
      html.pre-dark body.stats-page {
        background: #1a1a2e;
        color: #e8e4ff;
      }

      body.stats-page {
        min-height: 100dvh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 32px 20px 80px;
      }

      body.stats-page.dark-mode {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: #e8e4ff;
      }

      .stats-hero {
        max-width: 1024px;
        margin: 0 auto 24px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
      }

      .stats-hero h1 {
        font-size: clamp(1.8em, 4.5vw, 2.6em);
        margin: 0;
        letter-spacing: 0.5px;
        text-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
      }

      .stats-hero .tagline {
        opacity: 0.85;
        font-size: 0.95em;
        max-width: 720px;
        line-height: 1.5;
      }

      .stats-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .stats-actions .ctrl-pill {
        text-decoration: none;
      }

      /* Darkened alongside the shared `.ctrl-pill` fix (2026-08-22): at
         0.18 alpha this was a pale pink wash carrying white text, which is
         unreadable on the light dashboard. Keeps the red signal for a
         destructive action, but earns its own contrast. */
      .stats-actions .ctrl-danger {
        background: rgba(150, 22, 30, 0.78);
        border-color: rgba(255, 130, 130, 0.5);
      }

      .stats-actions .ctrl-danger:hover {
        background: rgba(178, 26, 36, 0.92);
      }

      .stats-main {
        max-width: 1024px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 28px;
      }

      /* ─── Activity panel (T-retention, 2026-05-20) ───────────────── */
      /* The 7-day activity strip lives at the top of `/stats` and
         answers the *"is the child coming back?"* question at a glance.
         Each day cell stacks one family-coloured dot per family in
         `FAMILY_ORDER` (seven since 2026-08-17); an active dot
         (`.is-active`) means at least one game in that family was
         played that day. SSR ships the cells in their inactive shape;
         the hydrating script toggles `.is-active` once `localStorage`
         is available. */
      .stats-activity {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 18px;
        padding: 18px 20px 16px;
        backdrop-filter: blur(10px);
      }

      .stats-activity-head {
        margin: 0 0 14px;
      }

      .stats-activity-title {
        margin: 0;
        font-size: 1.15em;
        font-weight: 600;
        letter-spacing: 0.2px;
      }

      .stats-activity-sub {
        margin: 4px 0 0;
        font-size: 0.88em;
        opacity: 0.78;
        line-height: 1.45;
      }

      .stats-activity-grid {
        list-style: none;
        margin: 0 0 14px;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
      }

      .stats-activity-day {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 10px 4px 8px;
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.18);
        min-width: 0;
      }

      /* Highlight today (the rightmost cell). The grid renders oldest
         first, today last, so :last-child is correct. */
      .stats-activity-day:last-child {
        background: rgba(255, 255, 255, 0.16);
        outline: 1px solid rgba(255, 255, 255, 0.28);
      }

      .stats-activity-dots {
        display: flex;
        flex-direction: column;
        gap: 4px;
        align-items: center;
        min-height: 56px;
        justify-content: flex-end;
      }

      .stats-activity-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.22);
        transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
      }

      .stats-activity-dot.is-active {
        background: var(--family-color, #fff);
        border-color: var(--family-color, #fff);
        box-shadow: 0 0 6px var(--family-color, #fff);
      }

      .stats-activity-day-label {
        font-size: 0.78em;
        font-weight: 600;
        opacity: 0.85;
        letter-spacing: 0.3px;
      }

      .stats-activity-day-date {
        font-size: 0.7em;
        opacity: 0.55;
        font-variant-numeric: tabular-nums;
      }

      .stats-activity-legend {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        font-size: 0.78em;
        opacity: 0.78;
      }

      .stats-activity-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .stats-activity-legend-swatch {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--family-color, #fff);
        flex-shrink: 0;
      }

      /* Tighter day cells on small screens so 7 columns still fit
         without horizontal scroll. */
      @media (max-width: 480px) {
        .stats-activity {
          padding: 14px 14px 12px;
        }
        .stats-activity-grid {
          gap: 4px;
        }
        .stats-activity-day {
          padding: 8px 2px 6px;
        }
        .stats-activity-day-date {
          display: none;
        }
      }

      .stats-section-title {
        margin: 0 0 12px;
        padding-bottom: 8px;
        font-size: 1.15em;
        font-weight: 600;
        letter-spacing: 0.2px;
        opacity: 0.92;
        border-bottom: 1px solid rgba(255, 255, 255, 0.18);
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
      }

      .stats-card {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding: 18px 18px 14px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-left-width: 4px;
        color: #fff;
        transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
      }

      .stats-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.22);
        background: rgba(255, 255, 255, 0.14);
      }

      /* Family-tinted left border so the section grouping is visible
         even when scrolling and section headers are above the fold.
         These accent colors are deliberately distinct from the
         FAMILY_COLORS palette in stats-registry.ts (which paints the
         activity dots) — those are functional colour-coding for the
         calendar; these are decorative tints for card edges. */
      .stats-card[data-family='preschool-math'] {
        border-left-color: #ffd166;
      }
      .stats-card[data-family='preschool-literacy'] {
        border-left-color: #f78fb3;
      }
      .stats-card[data-family='preschool-cognitive'] {
        border-left-color: #5eead4;
      }
      .stats-card[data-family='preschool-social'] {
        border-left-color: #a5b4fc;
      }
      .stats-card[data-family='story'] {
        border-left-color: #ef476f;
      }
      .stats-card[data-family='card-set'] {
        border-left-color: #06d6a0;
      }
      .stats-card[data-family='card-pure'] {
        border-left-color: #4cc9f0;
      }

      .stats-card.is-empty {
        opacity: 0.78;
      }

      .stats-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }

      .stats-card-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: inherit;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05em;
      }

      .stats-card-title:hover {
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .stats-card-emoji {
        font-size: 1.35em;
        line-height: 1;
      }

      .stats-card-arrow {
        opacity: 0.6;
        font-size: 0.9em;
        transition: transform 0.18s, opacity 0.18s;
      }

      .stats-card-title:hover .stats-card-arrow {
        opacity: 1;
        transform: translateX(2px);
      }

      .stats-card-empty {
        font-size: 0.7em;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 3px 8px;
        border-radius: 50px;
        background: rgba(0, 0, 0, 0.35);
      }

      .stats-card-rows {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .stats-row {
        display: grid;
        grid-template-columns: 22px 1fr auto;
        align-items: center;
        gap: 8px;
        font-size: 0.92em;
        line-height: 1.4;
      }

      .stats-row-emoji {
        font-size: 1em;
      }

      .stats-row-label {
        opacity: 0.85;
      }

      .stats-row-value {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
      }

      .stats-reset {
        align-self: flex-end;
        font-size: 0.78em;
        padding: 4px 10px;
        border-radius: 50px;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        cursor: pointer;
        transition: background 0.18s, border-color 0.18s;
      }

      .stats-reset:hover {
        background: rgba(255, 80, 80, 0.32);
        border-color: rgba(255, 80, 80, 0.55);
      }

      @media (prefers-reduced-motion: reduce) {
        .stats-card,
        .stats-card-arrow,
        .stats-reset {
          transition: none;
        }
      }

      @media (max-width: 480px) {
        body.stats-page {
          padding: 20px 14px 60px;
        }
        .stats-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
