---
import GridLayout from '@/layouts/GridLayout.astro';
import { ALL_CARDS, FILTERS } from '@/data/hindi';

const title = 'Hindi — Kids Learning Games';
const description =
  'Learn the Hindi varnamala — 12 vowels and 36 consonants — with Devanagari script, example words, transliteration, pictures, and kid-friendly facts.';

const totalCards = ALL_CARDS.length;
---

<GridLayout
  title={title}
  description={description}
  themeColor="#ff9933"
  theme="hindi"
>
  <main class="gl-shell" aria-label="Hindi alphabets game">
    <header class="gl-header">
      <h1 class="gl-title">
        <span class="gl-title-emoji" aria-hidden="true">🇮🇳</span>
        <span lang="hi">हिंदी</span>
        <span class="gl-title-divider" aria-hidden="true">·</span>
        Hindi
      </h1>

      <div class="gl-header-right">
        <span
          class="gl-progress-pill"
          id="progressPill"
          aria-label={`Progress: 0 of ${totalCards} letters learned`}
        >
          <span id="progressText">0 / {totalCards}</span>
          <span class="gl-progress-bar" aria-hidden="true">
            <span class="gl-progress-bar-fill" id="progressFill"></span>
          </span>
        </span>
        <div class="ctrl-row">
          <button class="ctrl-pill" id="btnQuiz" type="button">🧠 Quiz</button>
          <button class="ctrl-pill" id="btnStats" type="button">📊 Stats</button>
          <button class="ctrl-pill" id="btnSettings" type="button">⚙️ Settings</button>
        </div>
      </div>
    </header>

    <div class="cat-bar" id="catBar" role="group" aria-label="Hindi letter filter">
      {
        FILTERS.map((f) => (
          <button
            class={`cat-btn${f.key === 'all' ? ' active' : ''}`}
            data-key={f.key}
            type="button"
          >
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="gl-deck gl-deck--capped" id="deck" role="list" aria-label="Hindi letter tiles">
      {
        ALL_CARDS.map((c, i) => (
          <button
            class="gl-tile"
            type="button"
            role="listitem"
            data-idx={i}
            data-letter={c.letter}
            data-type={c.type}
            aria-label={`Letter ${c.letter} (${c.pron}) for ${c.word} ${c.trans} meaning ${c.n}`}
            lang="hi"
          >
            {c.letter}
            <span class="gl-tile-check" aria-hidden="true">✓</span>
          </button>
        ))
      }
    </div>

    <section class="gl-detail gl-detail--empty" id="detail" aria-live="polite">
      <div class="gl-detail-inner">
        <div class="gl-detail-head">
          <span class="gl-detail-letter" id="detailLetter" lang="hi">अ</span>
          <div class="gl-detail-word-row">
            <span class="gl-detail-word">
              <span id="detailWord" lang="hi">अनार</span>
              <span class="gl-detail-trans" id="detailTrans">Anar</span>
            </span>
            <span class="gl-detail-pill" id="detailPill">स्वर Vowel</span>
          </div>
        </div>

        <div class="gl-detail-image-wrap">
          <img
            class="gl-detail-image"
            id="detailImage"
            alt=""
            width="260"
            height="260"
            loading="eager"
          />
        </div>

        <p class="gl-detail-fact" id="detailFact">
          Tap any letter above to hear it and see a picture!
        </p>

        <div class="gl-detail-actions">
          <button
            class="gl-detail-arrow"
            id="prevBtn"
            type="button"
            aria-label="Previous letter"
          >
            ◀
          </button>
          <button
            class="gl-detail-hear"
            id="hearBtn"
            type="button"
            aria-label="Play letter sound"
          >
            🔊 सुनें · Hear
          </button>
          <button
            class="gl-detail-arrow"
            id="nextBtn"
            type="button"
            aria-label="Next letter"
          >
            ▶
          </button>
        </div>
      </div>
    </section>
  </main>

  <div class="gl-done-overlay" id="doneOverlay" role="dialog" aria-live="polite" aria-labelledby="doneTitle">
    <div class="gl-done-card">
      <h2 id="doneTitle">शाबाश! You learned every Hindi letter! 🎉</h2>
      <p>You've explored all 48 letters of the Hindi varnamala. Want to go again?</p>
      <button class="gl-done-restart" id="restartBtn" type="button">
        Start Over
      </button>
    </div>
  </div>

  <div class="gl-quiz-overlay" id="quizOverlay" role="dialog" aria-modal="true" aria-labelledby="quizHeading">
    <div class="gl-quiz-card">
      <button class="gl-quiz-close" id="quizCloseBtn" type="button" aria-label="Close quiz">&times;</button>
      <h2 class="quiz-heading" id="quizHeading">🧠 Quick Hindi Quiz</h2>
      <div id="quizBody"></div>
      <div class="quiz-result" id="quizResult" hidden>
        <div class="quiz-result-emoji" id="quizResEmoji" aria-hidden="true"></div>
        <div class="quiz-result-text" id="quizResText"></div>
        <div class="quiz-result-actions">
          <button class="gl-quiz-retry-btn" id="quizRetryBtn" type="button">🔄 Try Again</button>
          <button class="gl-quiz-retry-btn" id="quizDoneBtn" type="button">Close</button>
        </div>
      </div>
    </div>
  </div>
</GridLayout>

<style is:global>
  /* Page-local additions for the Hindi detail card. The base
     `.gl-detail-word` slot in `grid.css` is laid out for a single
     line ("Apple" / "Banana"); Hindi packs a Devanagari word + a
     romanised transliteration on top of each other, so we stack
     them inside the same slot. The transliteration uses a smaller,
     italicised secondary style. */
  body.grid[data-theme='hindi'] .gl-detail-word {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.1;
    gap: 2px;
  }
  body.grid[data-theme='hindi'] .gl-detail-trans {
    display: block;
    font-size: 0.65em;
    font-weight: 600;
    font-style: italic;
    opacity: 0.8;
    letter-spacing: 0.3px;
  }

  /* Title row middle-dot divider — matches the "हिंदी · Hindi" theme. */
  body.grid[data-theme='hindi'] .gl-title-divider {
    opacity: 0.55;
    margin: 0 0.18em;
    font-weight: 400;
  }

  /* Devanagari script + Latin numerals share the tile face, but
     Devanagari renders a touch smaller than Latin caps in most
     system fonts (the akshara has a top-bar plus matras above and
     below). Bump tile font-size up by ~12% on `data-theme='hindi'`
     so क्ष and ज्ञ (the heaviest compound consonants) read as
     clearly as A and B do on the alphabets grid. */
  body.grid[data-theme='hindi'] .gl-tile {
    font-size: clamp(1.55em, 4.4vw, 2.4em);
    font-weight: 700;
  }
  body.grid[data-theme='hindi'] .gl-detail-letter {
    font-size: clamp(2.6em, 7.5vw, 4em);
    font-weight: 700;
  }
</style>

<script>
  import { playTap } from '@/lib/audio';
  import { speak } from '@/lib/speech';
  import { launchConfetti } from '@/lib/achievements';
  import { getSettings } from '@/lib/settings';
  import { loadLearned, saveLearned } from '@/lib/progress';
  import { mountQuiz } from '@/lib/quiz';
  import { ALL_CARDS, QUIZ } from '@/data/hindi';
  import { FLUENT_IMG_BASE } from '@/data/fluent';

  // Progress persistence — uses the shared `src/lib/progress.ts` helper.
  // Game id maps to `kids_progress_v1:hindi`.
  const GAME_ID = 'hindi';

  // Confetti palette for the quiz perfect-score effect — saffron /
  // white / green tricolor + accent saffron + sunshine — same palette
  // as the showDone() overlay so the burst stays culturally on-theme.
  const HINDI_COLORS = ['#ff9933', '#ffffff', '#138808', '#cc5500', '#ffd54f'];

  // --- State ---
  let learned = loadLearned(GAME_ID);
  let activeIdx: number | null = null;
  let activeFilter: 'all' | 'vowel' | 'consonant' = 'all';

  // --- DOM refs ---
  const deckEl = document.getElementById('deck')!;
  const detailEl = document.getElementById('detail')!;
  const detailLetter = document.getElementById('detailLetter')!;
  const detailWord = document.getElementById('detailWord')!;
  const detailTrans = document.getElementById('detailTrans')!;
  const detailPill = document.getElementById('detailPill')!;
  const detailImage = document.getElementById('detailImage') as HTMLImageElement;
  const detailFact = document.getElementById('detailFact')!;
  const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
  const hearBtn = document.getElementById('hearBtn') as HTMLButtonElement;
  const progressText = document.getElementById('progressText')!;
  const progressFill = document.getElementById('progressFill')!;
  const catBar = document.getElementById('catBar')!;
  const doneOverlay = document.getElementById('doneOverlay')!;
  const restartBtn = document.getElementById('restartBtn') as HTMLButtonElement;

  const tiles = Array.from(
    deckEl.querySelectorAll<HTMLButtonElement>('.gl-tile'),
  );

  // --- Helpers ---
  const tileVisible = (t: HTMLButtonElement): boolean =>
    activeFilter === 'all' || t.dataset.type === activeFilter;

  const updateProgressUI = (): void => {
    const n = learned.size;
    const total = ALL_CARDS.length;
    progressText.textContent = `${n} / ${total}`;
    progressFill.style.width = `${(n / total) * 100}%`;
    const pill = document.getElementById('progressPill');
    if (pill) {
      pill.setAttribute(
        'aria-label',
        `Progress: ${n} of ${total} letters learned`,
      );
    }
  };

  const applyTileStates = (): void => {
    for (const t of tiles) {
      const letter = t.dataset.letter!;
      t.classList.toggle('learned', learned.has(letter));
      t.classList.toggle('active', activeIdx !== null && +t.dataset.idx! === activeIdx);
      t.hidden = !tileVisible(t);
    }
  };

  const applyFilter = (key: 'all' | 'vowel' | 'consonant'): void => {
    activeFilter = key;
    for (const b of catBar.querySelectorAll<HTMLButtonElement>('.cat-btn')) {
      b.classList.toggle('active', b.dataset.key === key);
    }
    applyTileStates();
  };

  // SVG-emoji fallback for Fluent UI image misses. Same shape as
  // alphabets / animals / birds — keeps the helper canonical.
  const installImageFallback = (img: HTMLImageElement, emoji: string): void => {
    img.onerror = () => {
      img.onerror = null;
      const safe = emoji.replace(/"/g, '&quot;');
      img.src =
        'data:image/svg+xml;utf8,' +
        encodeURIComponent(
          `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96"><text x="50%" y="50%" text-anchor="middle" dy=".3em" font-size="64">${safe}</text></svg>`,
        );
    };
  };

  const showDetail = (idx: number, opts: { scroll?: boolean } = {}): void => {
    const c = ALL_CARDS[idx];
    if (!c) return;
    activeIdx = idx;

    detailEl.classList.remove('gl-detail--empty');
    detailLetter.textContent = c.letter;
    detailWord.textContent = c.word;
    detailTrans.textContent = c.trans;
    detailPill.textContent = c.label;
    detailPill.dataset.type = c.type;
    detailFact.textContent = c.f;
    detailImage.alt = c.n;
    installImageFallback(detailImage, c.e);
    detailImage.src = FLUENT_IMG_BASE + c.img;

    // Pop animation — toggle class to restart it on every update.
    detailImage.classList.remove('pop');
    void detailImage.offsetWidth; // eslint-disable-line @typescript-eslint/no-unused-expressions
    detailImage.classList.add('pop');

    // Navigation button state (linear within the current filter).
    const visibleIdxs = tiles
      .filter(tileVisible)
      .map((t) => +t.dataset.idx!);
    const posInFiltered = visibleIdxs.indexOf(idx);
    prevBtn.disabled = posInFiltered <= 0;
    nextBtn.disabled =
      posInFiltered === -1 || posInFiltered >= visibleIdxs.length - 1;

    applyTileStates();

    if (opts.scroll) {
      detailEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  };

  const markLearned = (letter: string): void => {
    if (learned.has(letter)) return;
    learned.add(letter);
    saveLearned(GAME_ID, learned);
    updateProgressUI();
    applyTileStates();
    if (learned.size === ALL_CARDS.length) {
      showDone();
    }
  };

  // Speech: Hindi letter + word in `hi-IN` voice (slower rate so
  // young learners can match the akshara to the syllable). The
  // English fact stays in the default voice — vanilla precedent.
  const speakCard = (idx: number): void => {
    const c = ALL_CARDS[idx];
    if (!c) return;
    const settings = getSettings();
    if (!settings.autoSpeak) return;
    speak(`${c.letter}. ${c.word}.`, { lang: 'hi-IN', rate: 0.75 });
  };

  const onTileTap = (t: HTMLButtonElement): void => {
    const idx = +t.dataset.idx!;
    const letter = t.dataset.letter!;
    playTap();
    t.classList.remove('just-tapped');
    void t.offsetWidth; // eslint-disable-line @typescript-eslint/no-unused-expressions
    t.classList.add('just-tapped');
    showDetail(idx, { scroll: true });
    markLearned(letter);
    speakCard(idx);
  };

  const navigate = (delta: -1 | 1): void => {
    if (activeIdx === null) {
      const first = tiles.find(tileVisible);
      if (first) {
        onTileTap(first);
      }
      return;
    }
    const visibleIdxs = tiles
      .filter(tileVisible)
      .map((t) => +t.dataset.idx!);
    const pos = visibleIdxs.indexOf(activeIdx);
    if (pos === -1) return;
    const nextPos = pos + delta;
    if (nextPos < 0 || nextPos >= visibleIdxs.length) return;
    const nextIdx = visibleIdxs[nextPos]!;
    const target = tiles[nextIdx]!;
    onTileTap(target);
  };

  const showDone = (): void => {
    doneOverlay.classList.add('show');
    // Tricolor confetti — saffron, white, green — plus a couple
    // of grace-note accents so it doesn't look like an Italian
    // flag (similar palette).
    launchConfetti(['#ff9933', '#ffffff', '#138808', '#cc5500', '#ffd54f']);
  };

  const restart = (): void => {
    learned = new Set();
    saveLearned(GAME_ID, learned);
    activeIdx = null;
    detailEl.classList.add('gl-detail--empty');
    detailFact.textContent = 'Tap any letter above to hear it and see a picture!';
    updateProgressUI();
    applyTileStates();
    doneOverlay.classList.remove('show');
  };

  // --- Event wiring ---
  deckEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      '.gl-tile',
    );
    if (btn && !btn.hidden) onTileTap(btn);
  });

  catBar.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
      '.cat-btn',
    );
    if (!btn) return;
    playTap();
    const key = btn.dataset.key as 'all' | 'vowel' | 'consonant';
    applyFilter(key);
    if (activeIdx !== null) {
      const currentTile = tiles[activeIdx];
      if (currentTile && !tileVisible(currentTile)) {
        activeIdx = null;
        detailEl.classList.add('gl-detail--empty');
        detailFact.textContent = 'Tap any letter above to hear it and see a picture!';
      }
    }
  });

  prevBtn.addEventListener('click', () => {
    playTap();
    navigate(-1);
  });

  nextBtn.addEventListener('click', () => {
    playTap();
    navigate(1);
  });

  hearBtn.addEventListener('click', () => {
    playTap();
    if (activeIdx === null) {
      const first = tiles.find(tileVisible);
      if (first) onTileTap(first);
      return;
    }
    const c = ALL_CARDS[activeIdx];
    if (!c) return;
    speak(`${c.letter}. ${c.word}.`, { lang: 'hi-IN', rate: 0.75 });
  });

  restartBtn.addEventListener('click', () => {
    playTap();
    restart();
  });

  document.getElementById('btnSettings')?.addEventListener('click', () => {
    playTap();
    (window as unknown as { openSettings?: () => void }).openSettings?.();
  });

  // --- Quiz modal wiring ---------------------------------------------
  const quizOverlay = document.getElementById('quizOverlay');
  const quizBody = document.getElementById('quizBody');
  const quizResult = document.getElementById('quizResult');
  const quizResEmoji = document.getElementById('quizResEmoji');
  const quizResText = document.getElementById('quizResText');

  const quiz =
    quizOverlay && quizBody && quizResult && quizResEmoji && quizResText
      ? mountQuiz({
          gameId: GAME_ID,
          questions: QUIZ,
          bodyEl: quizBody,
          resultEl: quizResult,
          resultEmojiEl: quizResEmoji,
          resultTextEl: quizResText,
          messages: {
            perfect: 'शाबाश! Perfect score!',
            great: 'बहुत बढ़िया! Great job!',
            keepReading: 'Tap a few more letters and try again!',
          },
          onPerfect: () => launchConfetti(HINDI_COLORS),
          playTap,
        })
      : null;

  const closeQuizModal = (): void => {
    quizOverlay?.classList.remove('show');
  };

  document.getElementById('btnQuiz')?.addEventListener('click', () => {
    if (!quiz || !quizOverlay) return;
    playTap();
    quizOverlay.classList.add('show');
    quiz.start();
  });

  document.getElementById('quizCloseBtn')?.addEventListener('click', () => {
    playTap();
    closeQuizModal();
  });
  document.getElementById('quizDoneBtn')?.addEventListener('click', () => {
    playTap();
    closeQuizModal();
  });
  document.getElementById('quizRetryBtn')?.addEventListener('click', () => {
    playTap();
    quiz?.start();
  });
  quizOverlay?.addEventListener('click', (e) => {
    if (e.target === quizOverlay) closeQuizModal();
  });

  document.getElementById('btnStats')?.addEventListener('click', () => {
    playTap();
    const state = quiz?.getState() ?? { attempts: 0, bestScore: 0, lastPlayed: '' };
    const lines = [
      `🇮🇳 Letters learned: ${learned.size} of ${ALL_CARDS.length}`,
      `🧠 Quiz attempts: ${state.attempts}`,
      `🏆 Best score: ${state.bestScore}%`,
      state.lastPlayed ? `📅 Last played: ${state.lastPlayed}` : '📅 Last played: never',
    ];
    alert(lines.join('\n'));
  });

  // Keyboard navigation (arrow keys) — helpful for desktop users.
  // Suspended while the quiz modal is open; Escape closes the modal.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && quizOverlay?.classList.contains('show')) {
      e.preventDefault();
      closeQuizModal();
      return;
    }
    if (quizOverlay?.classList.contains('show')) return;
    if (e.target instanceof HTMLInputElement) return;
    if (e.key === 'ArrowLeft') navigate(-1);
    else if (e.key === 'ArrowRight') navigate(1);
  });

  // --- Initial render ---
  updateProgressUI();
  applyTileStates();
</script>
