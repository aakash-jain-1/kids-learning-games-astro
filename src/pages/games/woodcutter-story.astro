---
// Honest Woodcutter — second StoryLayout consumer, 13th and final game
// in the migration. Single hero scene + 4 paragraphs of prose + moral
// panel + 6-question comprehension quiz. See `src/data/woodcutter.ts`
// for the layout decision rationale and animation choreography.
//
// Unlike Daily Routines this page is *not* paginated — the layout
// supplies the head/meta/nav/settings shell, but the page itself
// omits the progress bar and Prev/Next chrome. The two action buttons
// (Play Animation / Reset) replay the scene's CSS animations by
// re-setting `.scene-art`'s innerHTML.

import StoryLayout from '@/layouts/StoryLayout.astro';
import GameControls from '@/components/GameControls.astro';
import '@/styles/woodcutter.css';
import { SCENE_ART_HTML, STORY, MORAL } from '@/data/woodcutter';

const title = 'The Honest Woodcutter — Kids Learning Games';
const description =
  'Read the tale of the Honest Woodcutter — an animated single-scene story with prose, a moral panel, and a 6-question comprehension quiz on honesty.';
---

<StoryLayout title={title} description={description} themeColor="#1e3c72" theme="woodcutter">
  <main class="story-shell" aria-label="The Honest Woodcutter story">
    <header class="story-header">
      <h1 class="story-title">
        <span aria-hidden="true">🪓</span>
        The Honest Woodcutter
        <span aria-hidden="true">🧚‍♀️</span>
      </h1>
      <GameControls quiz={false} />
    </header>

    <section class="scene-box" aria-label="Animated story scene">
      <div class="scene-art woodcutter-art" id="sceneArt" aria-hidden="true" set:html={SCENE_ART_HTML} />
    </section>

    <div class="story-controls">
      <button class="story-btn story-btn--next" id="playBtn" type="button" aria-label="Play scene animation">
        ▶️ Play Animation
      </button>
      <button class="story-btn story-btn--prev" id="resetBtn" type="button" aria-label="Reset scene animation">
        🔄 Reset
      </button>
    </div>

    <article class="story-prose" aria-labelledby="storyHeading">
      <h2 class="prose-heading" id="storyHeading">📖 The Story</h2>
      {STORY.map((p) => <p class="prose-para">{p}</p>)}
    </article>

    <aside class="story-moral" aria-label="Moral of the story">
      <h2>✨ Moral of the Story ✨</h2>
      <p>{MORAL}</p>
    </aside>

    <section class="quiz-box" aria-labelledby="quizTitle" aria-live="polite">
      <h2 class="quiz-heading" id="quizTitle">📝 Comprehension Quiz</h2>
      <div id="quizBody"></div>
      <div class="quiz-result" id="quizResult" hidden>
        <div class="quiz-result-emoji" id="quizResEmoji" aria-hidden="true"></div>
        <div class="quiz-result-text" id="quizResText"></div>
        <div class="quiz-result-actions">
          <button class="story-btn story-btn--restart" id="quizRetryBtn" type="button">
            🔄 Try Again
          </button>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Set the body background once at load — Woodcutter doesn't morph
    // per-scene like Routines does, so this is just a constant. (Kept
    // inline so the gradient paints before hydration even though the
    // value matches the `--st-bg` default for `[data-theme=woodcutter]`.)
    document.body.style.setProperty(
      '--st-bg',
      'linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #7e22ce 100%)',
    );
  </script>
</StoryLayout>

<script>
  import { playTap } from '@/lib/audio';
  import { launchConfetti } from '@/lib/achievements';
  import { mountQuiz } from '@/lib/quiz';
  import { QUIZ } from '@/data/woodcutter';

  const GAME_ID = 'woodcutter';
  const WOODCUTTER_CONFETTI = ['#1e3c72', '#2a5298', '#7e22ce', '#ffd700', '#c0c0c0', '#ffffff'];

  // --- Scene animation replay (Play / Reset) ---
  // Snapshot the original innerHTML at hydration; the button handlers
  // rebuild the scene from this snapshot. Re-setting innerHTML causes
  // the browser to re-evaluate every child's animation declarations
  // from t=0 — equivalent to vanilla's `style.animation = 'none'`
  // reset trick but without the per-element manual reset code.
  const sceneArt = document.getElementById('sceneArt') as HTMLElement | null;
  const playBtn = document.getElementById('playBtn') as HTMLButtonElement | null;
  const resetBtn = document.getElementById('resetBtn') as HTMLButtonElement | null;
  const SCENE_HTML = sceneArt?.innerHTML ?? '';

  const replayScene = (): void => {
    if (!sceneArt) return;
    sceneArt.innerHTML = '';
    void sceneArt.offsetHeight;
    sceneArt.innerHTML = SCENE_HTML;
  };

  playBtn?.addEventListener('click', () => {
    playTap();
    replayScene();
  });

  // --- Quiz mount (shared controller from src/lib/quiz.ts) ---
  const quizBody = document.getElementById('quizBody');
  const quizResult = document.getElementById('quizResult');
  const quizResEmoji = document.getElementById('quizResEmoji');
  const quizResText = document.getElementById('quizResText');

  const quiz =
    quizBody && quizResult && quizResEmoji && quizResText
      ? mountQuiz({
          gameId: GAME_ID,
          questions: QUIZ,
          bodyEl: quizBody,
          resultEl: quizResult,
          resultEmojiEl: quizResEmoji,
          resultTextEl: quizResText,
          messages: {
            perfect: 'Perfect! You truly understood the story!',
            great: 'Great job!',
            keepReading: 'Read the story again and try once more!',
          },
          onPerfect: () => launchConfetti(WOODCUTTER_CONFETTI),
          playTap,
        })
      : null;

  // Vanilla auto-starts the quiz on load — preserve that behaviour.
  quiz?.start();

  resetBtn?.addEventListener('click', () => {
    playTap();
    replayScene();
    quiz?.start();
  });

  document.getElementById('quizRetryBtn')?.addEventListener('click', () => {
    playTap();
    quiz?.start();
  });

  document.getElementById('btnSettings')?.addEventListener('click', () => {
    playTap();
    (window as unknown as { openSettings?: () => void }).openSettings?.();
  });

  document.getElementById('btnStats')?.addEventListener('click', () => {
    playTap();
    const state = quiz?.getState() ?? { attempts: 0, bestScore: 0, lastPlayed: '' };
    const lines = [
      `🧠 Quiz attempts: ${state.attempts}`,
      `🏆 Best score: ${state.bestScore}%`,
      state.lastPlayed ? `📅 Last played: ${state.lastPlayed}` : '📅 Last played: never',
    ];
    alert(lines.join('\n'));
  });
</script>
