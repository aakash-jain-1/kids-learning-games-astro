---
import StoryLayout from '@/layouts/StoryLayout.astro';
import GameControls from '@/components/GameControls.astro';
import '@/styles/addition.css';

import { generateSession, THEME_BY_KEY } from '@/data/addition';

const title = 'Counting Friends — Kids Learning Games';
const description =
  'A gentle counting and addition game for ages 3–4. Two groups of friendly objects appear in a colourful scene; tap each to count along, then pick the total. Audio narration, no scoring, no failures.';

// SSR a deterministic first round so the page never paints blank. The
// page script regenerates a fresh randomised 8-round session on first
// interaction (settings + audio context need a user gesture anyway), so
// this initial round is shown then immediately replaced — but it
// guarantees a meaningful first paint and gives Playwright stable
// selectors to assert on without running the script.
const SSR_FIRST_ROUND = generateSession(() => 0.42)[0]!;
const ssrTheme = THEME_BY_KEY[SSR_FIRST_ROUND.theme];

// Build the SSR caption + group items so the no-JS render is
// understandable even before hydration. The caption text mirrors the
// `intro` narration phase the script will speak on first interaction.
const ssrCaption = `Look! ${
  SSR_FIRST_ROUND.a === 1 ? 'one' :
  SSR_FIRST_ROUND.a === 2 ? 'two' :
  SSR_FIRST_ROUND.a === 3 ? 'three' :
  SSR_FIRST_ROUND.a === 4 ? 'four' : String(SSR_FIRST_ROUND.a)
} ${SSR_FIRST_ROUND.a === 1 ? ssrTheme.singular : ssrTheme.plural} ${ssrTheme.verbPhrase}.`;

const TOTAL_ROUNDS = 8;
---

<StoryLayout
  title={title}
  description={description}
  themeColor="#1976d2"
  theme="addition"
>
  <main class="cf-shell" aria-label="Counting Friends game">
    <header class="cf-header">
      <h1 class="cf-title">
        <span aria-hidden="true">🧮</span>
        <span>Counting Friends</span>
      </h1>

      <div class="cf-header-right" style="display: flex; gap: 10px; align-items: center;">
        <span class="cf-stage-pill" id="cfStagePill" aria-label="Stage 1, Starter">
          <span aria-hidden="true">⭐</span>
          <span id="cfStageText">Stage 1</span>
        </span>
        <span
          class="cf-progress-pill"
          id="cfProgressPill"
          aria-label={`Round 1 of ${TOTAL_ROUNDS}`}
        >
          <span id="cfProgressText">1 / {TOTAL_ROUNDS}</span>
          <span class="cf-progress-bar" aria-hidden="true">
            <span class="cf-progress-fill" id="cfProgressFill"></span>
          </span>
        </span>
        <GameControls />
      </div>
    </header>

    <section
      class="cf-stage"
      id="cfStage"
      data-scene={SSR_FIRST_ROUND.theme}
      aria-label="Counting scene"
    >
      <div
        class="cf-caption"
        id="cfCaption"
        role="status"
        aria-live="polite"
      >
        {ssrCaption}
      </div>

      <div class="cf-groups" aria-label="Two groups of friends">
        <div
          class="cf-group"
          id="cfGroupA"
          aria-label={`Group A — ${SSR_FIRST_ROUND.a} ${
            SSR_FIRST_ROUND.a === 1 ? ssrTheme.singular : ssrTheme.plural
          }`}
        >
          {
            Array.from({ length: SSR_FIRST_ROUND.a }, (_, i) => (
              <button
                type="button"
                class="cf-item"
                style={`--cf-i: ${i * 0.12}s`}
                aria-label={`${ssrTheme.singular} ${i + 1}`}
              >
                <span aria-hidden="true">{ssrTheme.emoji}</span>
              </button>
            ))
          }
        </div>

        <span class="cf-plus" aria-hidden="true">and</span>

        <div
          class="cf-group"
          id="cfGroupB"
          aria-label={`Group B — ${SSR_FIRST_ROUND.b} ${
            SSR_FIRST_ROUND.b === 1 ? ssrTheme.singular : ssrTheme.plural
          }`}
        >
          {
            Array.from({ length: SSR_FIRST_ROUND.b }, (_, i) => (
              <button
                type="button"
                class="cf-item"
                style={`--cf-i: ${(i + SSR_FIRST_ROUND.a) * 0.12}s`}
                aria-label={`${ssrTheme.singular} ${SSR_FIRST_ROUND.a + i + 1}`}
              >
                <span aria-hidden="true">{ssrTheme.emoji}</span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <div class="cf-options" id="cfOptions" role="group" aria-label="How many friends in all?">
      {
        SSR_FIRST_ROUND.options.map((n) => (
          <button
            type="button"
            class="cf-opt"
            data-n={n}
            aria-label={`${n}`}
          >
            <span class="cf-opt-digit" aria-hidden="true">{n}</span>
            <span class="cf-opt-frame" aria-hidden="true">
              {Array.from({ length: 5 }, (_, i) => (
                <span
                  class={`cf-opt-dot${i < n ? ' cf-opt-dot--filled' : ''}`}
                />
              ))}
            </span>
          </button>
        ))
      }
    </div>

    <footer class="cf-footer">
      <button type="button" class="cf-action" id="cfReplayBtn" aria-label="Replay this round's narration">
        🔊 Replay
      </button>
      <button type="button" class="cf-action cf-action--primary" id="cfNextBtn" aria-label="Next round" disabled>
        Next round →
      </button>
    </footer>

    <div class="cf-done" id="cfDone" role="dialog" aria-live="polite" aria-labelledby="cfDoneTitle">
      <div class="cf-done-card">
        <div class="cf-done-emoji" aria-hidden="true">🌟</div>
        <h2 class="cf-done-title" id="cfDoneTitle">Counting champion!</h2>
        <p class="cf-done-text" id="cfDoneText">
          You counted with {TOTAL_ROUNDS} groups of friends today!
        </p>
        <div class="cf-done-actions">
          <button type="button" class="cf-action cf-action--primary" id="cfPlayAgainBtn">
            ▶ Play again
          </button>
          <a class="cf-action" href={import.meta.env.BASE_URL}>
            🏠 Home
          </a>
        </div>
      </div>
    </div>
  </main>
</StoryLayout>

<script>
  import { playTap, playCorrect } from '@/lib/audio';
  import { speak, cancelSpeech, isSpeechSupported } from '@/lib/speech';
  import { launchConfetti } from '@/lib/achievements';
  import { getSettings } from '@/lib/settings';
  import {
    generateSession,
    THEME_BY_KEY,
    buildNarration,
    loadAdditionStats,
    saveAdditionStats,
    type AdditionTheme,
    type Round,
    type RoundNarration,
  } from '@/data/addition';
  import {
    type StageId,
    STAGE_META,
    shouldAdvance,
    nextStage,
  } from '@/lib/preschool-stages';
  import { recordPlay } from '@/lib/retention';

  // Current stage (read from saved stats on load) + this session's
  // round count derived from it. `let` because Play Again may bump the
  // stage after a high-accuracy session. (Named `currentStage` to avoid
  // colliding with the `stage` DOM-element ref declared below.)
  let currentStage: StageId = loadAdditionStats().stage;
  let TOTAL_ROUNDS = STAGE_META[currentStage].rounds;
  /** Dot-frame cell count for the current stage (5 = five-frame, 10 = ten-frame). */
  let frameSize = STAGE_META[currentStage].frameSize;
  // Confetti palette — happy primaries that read on every scene bg.
  const CF_COLORS = ['#4caf50', '#1976d2', '#ffd54f', '#e91e63', '#ff7043'];

  /**
   * Read round 0 from the SSR'd DOM so the JS session starts in sync
   * with whatever Astro rendered (deterministic seed in the page
   * frontmatter). This avoids a synchronous `renderRound()` DOM
   * replacement on first user interaction — without it, the very
   * first option click would race against `kickoff()` mutating the
   * options markup, and the click could land on a brand-new button
   * with a different `data-n` than the one the user (or test)
   * intended to tap. Reading state from the DOM keeps the SSR'd
   * markup live for round 0; rounds 1..N are JS-generated as usual.
   */
  const readSSRRound = (): Round => {
    const stageEl = document.getElementById('cfStage')!;
    const themeKey = (stageEl.dataset.scene ?? 'pond') as AdditionTheme;
    const a = stageEl.querySelectorAll('#cfGroupA .cf-item').length;
    const b = stageEl.querySelectorAll('#cfGroupB .cf-item').length;
    const optEls = Array.from(
      document.querySelectorAll<HTMLElement>('#cfOptions .cf-opt'),
    );
    // Defensive: if SSR shape ever drifts, fall back to a JS-generated
    // round so the page still works rather than throwing.
    if (a === 0 || b === 0 || optEls.length !== 3) {
      return generateSession()[0]!;
    }
    const opts = optEls.map((el) => Number(el.dataset.n));
    return {
      a,
      b,
      sum: a + b,
      theme: themeKey,
      options: [opts[0]!, opts[1]!, opts[2]!],
    };
  };

  // ── State ──────────────────────────────────────────────────────────
  // Round 0 mirrors the SSR'd DOM exactly (always a gentle Stage-1
  // warmup round); rounds 1..N are JS-random at the saved stage.
  let session: Round[] = [readSSRRound(), ...generateSession(Math.random, currentStage).slice(1)];
  let roundIdx = 0;
  /** Whether the child has tapped a numeral button yet on the current round. */
  let answered = false;
  /** Whether the *first* answer this round was correct. Tracked for stats. */
  let firstTryCorrect = false;
  /** First-try-correct count THIS session — drives auto stage advancement. */
  let sessionFirstTry = 0;
  /** Cached narration script for the current round so Replay doesn't re-build. */
  let currentNarration: RoundNarration | null = null;

  // ── DOM refs ───────────────────────────────────────────────────────
  const stage = document.getElementById('cfStage') as HTMLElement;
  const captionEl = document.getElementById('cfCaption') as HTMLElement;
  const groupAEl = document.getElementById('cfGroupA') as HTMLElement;
  const groupBEl = document.getElementById('cfGroupB') as HTMLElement;
  const optionsEl = document.getElementById('cfOptions') as HTMLElement;
  const progressText = document.getElementById('cfProgressText') as HTMLElement;
  const progressFill = document.getElementById('cfProgressFill') as HTMLElement;
  const progressPill = document.getElementById('cfProgressPill') as HTMLElement;
  const stagePill = document.getElementById('cfStagePill') as HTMLElement;
  const stageText = document.getElementById('cfStageText') as HTMLElement;
  const replayBtn = document.getElementById('cfReplayBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('cfNextBtn') as HTMLButtonElement;
  const doneEl = document.getElementById('cfDone') as HTMLElement;
  const playAgainBtn = document.getElementById('cfPlayAgainBtn') as HTMLButtonElement;

  // ── Audio helpers ──────────────────────────────────────────────────

  /**
   * Speak `text` if the user has sound enabled. We deliberately ignore
   * `getSettings().autoSpeak` (the global "auto-narrate facts" flag)
   * because narration is *essential* in this game — a 3yo can't read
   * the captions, so we always speak when sound is on. The on-screen
   * caption is the silent-mode fallback, not a redundant accessibility
   * mirror — it's the *primary* output when sound is muted.
   *
   * Always fires `opts.onEnd` exactly once. Three paths:
   *   1. Sound off (or speechSynthesis unsupported) → setTimeout
   *      fallback at ~600ms so the round still progresses.
   *   2. Sound on, speechSynthesis fires `onend` normally → wrap()
   *      is invoked from the speech engine.
   *   3. Sound on, but speechSynthesis never fires `onend` (some
   *      headless browsers + CI runners with no system TTS engine
   *      hit this; also Safari / mobile interrupt edge cases) →
   *      watchdog fires wrap() after a length-based estimate so we
   *      don't deadlock the round-progression chain.
   *
   * Watchdog discovered necessary 2026-05-15 by the new Playwright
   * suite: the wrong-answer rerun chain (`narrate(rerun) → ... →
   * narrate(rerunDone) → reveal`) timed out in CI because Chromium's
   * headless TTS never invoked the `onend` callbacks. Real browsers
   * with real audio fire `onend` long before the watchdog and the
   * watchdog becomes a no-op.
   */
  const narrate = (text: string, opts?: { onEnd?: () => void }): void => {
    const onEnd = opts?.onEnd;
    if (!isSpeechSupported() || !getSettings().sound) {
      if (onEnd) setTimeout(onEnd, 600);
      return;
    }
    let fired = false;
    const wrap = (): void => {
      if (fired) return;
      fired = true;
      onEnd?.();
    };
    // Watchdog: ~10 chars/sec at our 0.85 rate plus a 600ms baseline.
    // Generous; bigger than any real onend fires.
    const watchdogMs = Math.max(800, text.length * 100 + 600);
    if (onEnd) setTimeout(wrap, watchdogMs);
    // Slightly slower than `lib/speech.ts` default (0.9) — pace this
    // age group prefers, plus the rate matches preschool TV-show
    // narrators within ~10%.
    speak(text, { rate: 0.85, pitch: 1.15, onEnd: onEnd ? wrap : undefined });
  };

  /**
   * Update the visible caption text. Always visible — works as the
   * accessibility mirror for kids/parents who can read, and as the
   * primary output when sound is muted.
   */
  const setCaption = (text: string): void => {
    captionEl.textContent = text;
    // Replay the cfCaptionIn animation on every change.
    captionEl.style.animation = 'none';
    void captionEl.offsetWidth;
    captionEl.style.removeProperty('animation');
  };

  // ── Render helpers ─────────────────────────────────────────────────

  /** Build the inner HTML for one tap-to-count button. */
  const itemHtml = (emoji: string, indexInGroup: number, totalIndex: number, ariaLabel: string): string =>
    `<button type="button" class="cf-item" data-idx="${totalIndex}" style="--cf-i: ${indexInGroup * 0.12}s" aria-label="${ariaLabel}"><span aria-hidden="true">${emoji}</span></button>`;

  /**
   * Build the inner HTML for one numeral answer button. The dot-frame
   * renders `frameSize` cells (5 = five-frame, 10 = ten-frame) and
   * fills `min(n, frameSize)`; the digit is the primary cue, so an
   * over-ceiling distractor (e.g. option 11 in a ten-frame) simply
   * maxes the frame — same convention Stage 1 already uses for the
   * "6" distractor in its five-frame.
   */
  const optionHtml = (n: number): string => {
    const dots = Array.from({ length: frameSize }, (_, i) =>
      `<span class="cf-opt-dot${i < n ? ' cf-opt-dot--filled' : ''}"></span>`,
    ).join('');
    return `<button type="button" class="cf-opt cf-opt--frame-${frameSize}" data-n="${n}" aria-label="${n}"><span class="cf-opt-digit" aria-hidden="true">${n}</span><span class="cf-opt-frame" aria-hidden="true">${dots}</span></button>`;
  };

  /** Render the round's stage (groups + options) and update header. */
  const renderRound = (): void => {
    const round = session[roundIdx]!;
    const theme = THEME_BY_KEY[round.theme];

    // Header progress.
    progressText.textContent = `${roundIdx + 1} / ${TOTAL_ROUNDS}`;
    progressFill.style.width = `${((roundIdx + 1) / TOTAL_ROUNDS) * 100}%`;
    progressPill.setAttribute('aria-label', `Round ${roundIdx + 1} of ${TOTAL_ROUNDS}`);

    // Scene background morph.
    stage.dataset.scene = round.theme;

    // Group A.
    let aHtml = '';
    for (let i = 0; i < round.a; i++) {
      aHtml += itemHtml(theme.emoji, i, i, `${theme.singular} ${i + 1}`);
    }
    groupAEl.innerHTML = aHtml;
    groupAEl.setAttribute(
      'aria-label',
      `Group A — ${round.a} ${round.a === 1 ? theme.singular : theme.plural}`,
    );

    // Group B.
    let bHtml = '';
    for (let i = 0; i < round.b; i++) {
      bHtml += itemHtml(theme.emoji, round.a + i, round.a + i, `${theme.singular} ${round.a + i + 1}`);
    }
    groupBEl.innerHTML = bHtml;
    groupBEl.setAttribute(
      'aria-label',
      `Group B — ${round.b} ${round.b === 1 ? theme.singular : theme.plural}`,
    );

    // Numeral options.
    optionsEl.innerHTML = round.options.map(optionHtml).join('');

    // Reset per-round state.
    answered = false;
    firstTryCorrect = false;
    currentNarration = buildNarration(round);
    nextBtn.disabled = true;
    replayBtn.disabled = false;
  };

  /**
   * Run the per-round narration sequence: intro → addition → question.
   * Each phase is paced against the visual cue (Group A fade-in
   * already takes ~0.6s × the count via `--cf-i`, so the script
   * waits past that before starting the addition phase).
   */
  const speakIntroSequence = (): void => {
    const n = currentNarration;
    if (!n) return;
    const round = session[roundIdx]!;

    // Estimate a comfortable wait for Group A's last item to finish
    // its fly-in: 0.6s (fly-in keyframe) + (a - 1) × 0.12s stagger.
    const aRevealMs = 600 + Math.max(0, round.a - 1) * 120;
    // Same for Group B. Group B items have stagger starting at index `a`.
    const bRevealMs = 600 + Math.max(0, round.b - 1) * 120;

    setCaption(n.intro);
    narrate(n.intro, {
      onEnd: () => {
        // Wait for Group A to finish its fly-in if narration was fast.
        const wait = Math.max(200, aRevealMs - 800);
        setTimeout(() => {
          // Start Group B fly-in. Items already exist in DOM; we just
          // restart their animations by toggling a class.
          // (Astro renders Group A and B in the same paint, so both
          // animate concurrently — reusing the existing DOM and
          // playing both groups together is simpler and reads fine
          // for a 3yo since the *narration* paces the addition
          // pedagogy, not the animation order.)
          setCaption(n.addition);
          narrate(n.addition, {
            onEnd: () => {
              setTimeout(() => {
                setCaption(n.question);
                narrate(n.question);
              }, Math.max(150, bRevealMs - 800));
            },
          });
        }, wait);
      },
    });
  };

  /**
   * Run a guided count of every visible item, one at a time, with
   * audio narration. Used by the errorless wrong-answer flow.
   */
  const speakGuidedCount = (onDone: () => void): void => {
    const round = session[roundIdx]!;
    const theme = THEME_BY_KEY[round.theme];
    const allItems = Array.from(stage.querySelectorAll<HTMLButtonElement>('.cf-item'));
    let i = 0;

    const step = (): void => {
      if (i >= allItems.length) {
        onDone();
        return;
      }
      const item = allItems[i]!;
      item.classList.add('cf-counted', 'cf-pulse');
      setCaption(String(i + 1));
      const word =
        i + 1 === 1 ? 'one' :
        i + 1 === 2 ? 'two' :
        i + 1 === 3 ? 'three' :
        i + 1 === 4 ? 'four' :
        i + 1 === 5 ? 'five' : String(i + 1);
      narrate(word, {
        onEnd: () => {
          item.classList.remove('cf-pulse');
          i++;
          // Small pause between counts so it doesn't feel rushed.
          setTimeout(step, 180);
        },
      });
    };

    // Suffix the count with the round's theme so the close of the
    // count is a sentence the child can hear: "…five! Five ducks!"
    void theme; // Theme already encoded in narration; reference suppresses unused.
    step();
  };

  // ── Tap-to-count handler ───────────────────────────────────────────

  let tapCount = 0;
  const onItemTap = (item: HTMLButtonElement): void => {
    if (answered) return; // Lock counting once answer chosen.
    if (item.classList.contains('cf-counted')) return; // Don't double-count.

    item.classList.add('cf-counted');
    item.classList.remove('cf-pulse');
    void item.offsetWidth;
    item.classList.add('cf-pulse');

    tapCount++;
    setCaption(String(tapCount));
    const word =
      tapCount === 1 ? 'one' :
      tapCount === 2 ? 'two' :
      tapCount === 3 ? 'three' :
      tapCount === 4 ? 'four' :
      tapCount === 5 ? 'five' : String(tapCount);
    narrate(word);
  };

  /** Reset the tap-to-count state when a new round starts or replay fires. */
  const resetTapCount = (): void => {
    tapCount = 0;
    for (const el of stage.querySelectorAll<HTMLElement>('.cf-counted')) {
      el.classList.remove('cf-counted', 'cf-pulse');
    }
  };

  // ── Answer handler ─────────────────────────────────────────────────

  const onOptionTap = (btn: HTMLButtonElement): void => {
    if (answered) return;
    const round = session[roundIdx]!;
    const n = Number(btn.dataset.n);
    if (Number.isNaN(n)) return;
    playTap();

    if (n === round.sum) {
      // Correct — celebrate, persist stats, enable Next.
      answered = true;
      firstTryCorrect = true;
      btn.classList.add('cf-opt--correct');
      // Disable all options so further taps don't fire.
      for (const el of optionsEl.querySelectorAll<HTMLButtonElement>('.cf-opt')) {
        el.disabled = true;
      }
      playCorrect();
      cancelSpeech();
      const correctText = currentNarration?.correct ?? `Yes! ${n}!`;
      setCaption(correctText);
      narrate(correctText);
      launchConfetti(CF_COLORS);
      bumpStats(true);
      nextBtn.disabled = false;
    } else {
      // Wrong — errorless rerun. Don't punish; run a guided count
      // and then highlight the correct numeral. Keep options
      // tappable in case the child wants to tap the right answer
      // afterwards (matches the gentle "let's try the right one"
      // affordance Khan Kids uses), but mark this round answered so
      // a second wrong tap doesn't re-trigger the rerun.
      answered = true;
      firstTryCorrect = false;
      // Add a 250ms kinesthetic shake on the tapped wrong button so
      // the child gets immediate visual confirmation that their tap
      // registered. Mirrors the `mountQuiz`-game pattern shipped
      // 2026-05-20 (T-extra) — same age-safety guarantees: NO color
      // shift, NO desaturation, NO negative tone. The shake runs in
      // parallel with the audio narration that follows; they don't
      // compete for the same channel. The existing guided-count +
      // reveal-correct flow below stays exactly as-is.
      btn.classList.add('cf-opt--wrong');
      cancelSpeech();
      setCaption(currentNarration?.rerun ?? "Let's count them together!");
      narrate(currentNarration?.rerun ?? "Let's count them together!", {
        onEnd: () => {
          resetTapCount();
          speakGuidedCount(() => {
            const doneText = currentNarration?.rerunDone ?? `${round.sum}!`;
            setCaption(doneText);
            narrate(doneText, {
              onEnd: () => {
                // Highlight the correct option and enable Next.
                for (const el of optionsEl.querySelectorAll<HTMLButtonElement>('.cf-opt')) {
                  if (Number(el.dataset.n) === round.sum) {
                    el.classList.add('cf-opt--reveal');
                  } else {
                    el.disabled = true;
                  }
                }
                bumpStats(false);
                nextBtn.disabled = false;
              },
            });
          });
        },
      });
    }
  };

  // ── Round progression ──────────────────────────────────────────────

  const startRound = (): void => {
    cancelSpeech();
    resetTapCount();
    renderRound();
    // Defer narration to next frame so the freshly-rendered items
    // begin their fly-in *before* the speech starts.
    requestAnimationFrame(() => speakIntroSequence());
  };

  const onNext = (): void => {
    playTap();
    if (roundIdx >= TOTAL_ROUNDS - 1) {
      showSessionComplete();
      return;
    }
    roundIdx++;
    startRound();
  };

  const showSessionComplete = (): void => {
    cancelSpeech();
    const stats = loadAdditionStats();

    // Auto-advance one stage when the child cleared this session with
    // a high enough first-try rate. Never auto-drop. `bestStage` is the
    // high-water mark for the parent dashboard.
    const advanced = shouldAdvance(sessionFirstTry, TOTAL_ROUNDS, currentStage);
    const newStage = advanced ? nextStage(currentStage) : currentStage;
    saveAdditionStats({
      ...stats,
      sessions: stats.sessions + 1,
      stage: newStage,
      bestStage: Math.max(stats.bestStage, newStage) as StageId,
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
    recordPlay('counting-friends');

    // Adopt the new stage for the next Play Again session + the pill.
    currentStage = newStage;
    updateStagePill();

    const doneTitle = document.getElementById('cfDoneTitle') as HTMLElement;
    const doneText = document.getElementById('cfDoneText') as HTMLElement;
    doneEl.classList.add('cf-done--show');
    launchConfetti(CF_COLORS);

    if (advanced) {
      const meta = STAGE_META[currentStage];
      doneTitle.textContent = `You reached Stage ${currentStage}!`;
      doneText.textContent = `${meta.label} mode — new friends and bigger numbers to count!`;
      narrate(`Wow! You reached Stage ${currentStage}! ${meta.label} mode! New friends to count with!`);
    } else {
      doneTitle.textContent = 'Counting champion!';
      doneText.textContent = `You counted with ${TOTAL_ROUNDS} groups of friends today!`;
      narrate(`Wow! You counted with ${TOTAL_ROUNDS} groups of friends today! Great job!`);
    }
  };

  const onPlayAgain = (): void => {
    playTap();
    doneEl.classList.remove('cf-done--show');
    // Adopt the (possibly newly advanced) stage's round count + frame.
    TOTAL_ROUNDS = STAGE_META[currentStage].rounds;
    frameSize = STAGE_META[currentStage].frameSize;
    session = generateSession(Math.random, currentStage);
    roundIdx = 0;
    sessionFirstTry = 0;
    startRound();
  };

  // ── Stats persistence ──────────────────────────────────────────────

  const bumpStats = (correctFirstTry: boolean): void => {
    if (correctFirstTry) sessionFirstTry++;
    const stats = loadAdditionStats();
    saveAdditionStats({
      ...stats,
      rounds: stats.rounds + 1,
      correctFirstTry: stats.correctFirstTry + (correctFirstTry ? 1 : 0),
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
    recordPlay('counting-friends');
  };

  /** Sync the header stage pill to the current `currentStage`. */
  const updateStagePill = (): void => {
    const meta = STAGE_META[currentStage];
    stageText.textContent = `Stage ${currentStage}`;
    stagePill.setAttribute('aria-label', `Stage ${currentStage}, ${meta.label}`);
  };

  // ── Event wiring ───────────────────────────────────────────────────

  // Stage delegation — single listener handles every tap-to-count item.
  stage.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cf-item');
    if (btn) onItemTap(btn);
  });

  optionsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cf-opt');
    if (btn && !btn.disabled) onOptionTap(btn);
  });

  replayBtn.addEventListener('click', () => {
    playTap();
    cancelSpeech();
    // Rebuild the round from scratch — same content, fresh fly-in
    // animations, fresh tap-count state, fresh narration. Simplest
    // implementation that reads as "play it again from the top."
    if (!answered) {
      // Mid-round replay: just re-narrate from the beginning.
      resetTapCount();
      speakIntroSequence();
    } else {
      // Post-answer replay: re-narrate the round summary.
      const text = firstTryCorrect
        ? (currentNarration?.correct ?? '')
        : (currentNarration?.rerunDone ?? '');
      setCaption(text);
      narrate(text);
    }
  });

  nextBtn.addEventListener('click', onNext);
  playAgainBtn.addEventListener('click', onPlayAgain);

  // Settings + Quiz + Stats wiring (matches the convention used by
  // every other game). Counting Friends uses its own stats schema in
  // localStorage (`counting_friends_stats_v1`), so the Stats button
  // shows a parent-readable session/round breakdown.

  document.getElementById('btnSettings')?.addEventListener('click', () => {
    playTap();
    (window as unknown as { openSettings?: () => void }).openSettings?.();
  });

  document.getElementById('btnQuiz')?.addEventListener('click', () => {
    // No separate quiz — every round IS a quiz round. Replay the
    // current round so the button still feels active rather than
    // dead.
    playTap();
    cancelSpeech();
    speakIntroSequence();
  });

  document.getElementById('btnStats')?.addEventListener('click', () => {
    playTap();
    const stats = loadAdditionStats();
    const ratio =
      stats.rounds === 0
        ? 0
        : Math.round((stats.correctFirstTry / stats.rounds) * 100);
    const lines = [
      `🧮 Sessions completed: ${stats.sessions}`,
      `🌟 Rounds played: ${stats.rounds}`,
      `🎯 First-try correct: ${stats.correctFirstTry} (${ratio}%)`,
      stats.lastPlayed ? `📅 Last played: ${stats.lastPlayed}` : '📅 Last played: never',
    ];
    alert(lines.join('\n'));
  });

  // ── Initial state binding ──────────────────────────────────────────
  // The SSR'd DOM is round 0; we don't re-render it. We just bind
  // the JS state (currentNarration, header progress) so subsequent
  // logic — option clicks, replay button, item taps, etc. — has the
  // expected references.
  currentNarration = buildNarration(session[0]!);
  updateStagePill();
  progressText.textContent = `1 / ${TOTAL_ROUNDS}`;
  progressFill.style.width = `${(1 / TOTAL_ROUNDS) * 100}%`;
  progressPill.setAttribute('aria-label', `Round 1 of ${TOTAL_ROUNDS}`);

  // Don't auto-speak on first paint — browsers block speechSynthesis
  // until the first user gesture. We wait for the *first* tap
  // (anywhere on the page body) to kick off the intro narration.
  // Critically, kickoff does NOT call renderRound() — that would
  // race with the click event when the user's first interaction is
  // a tap on an option button (Playwright tests proved this race
  // empirically on 2026-05-15 — every option-click test failed
  // because the SSR'd `data-n` values had been swapped out by a
  // freshly-randomized JS session before the click could resolve).
  let kickedOff = false;
  const kickoff = (): void => {
    if (kickedOff) return;
    kickedOff = true;
    requestAnimationFrame(() => speakIntroSequence());
  };
  document.addEventListener('pointerdown', kickoff, { once: true });
  document.addEventListener('keydown', kickoff, { once: true });
</script>
