---
import StoryLayout from '@/layouts/StoryLayout.astro';
import GameControls from '@/components/GameControls.astro';
import '@/styles/comparison.css';

import { generateSession } from '@/data/comparison';
import { THEME_BY_KEY } from '@/lib/preschool-themes';

const title = 'More Friends — Kids Learning Games';
const description =
  'A gentle "which has more?" comparison game for ages 3–4. Two groups of friendly objects appear side by side; tap the group with more. Audio narration, no scoring, no failures. Companion game to Counting Friends.';

// SSR a deterministic first round so the page never paints blank. The
// page script reads round 0 directly from the SSR'd DOM (matching
// pattern from Counting Friends — see counting-friends-game.astro for
// the kickoff-race rationale that motivated this approach), and
// continues with random rounds 1..N after the user clicks Next.
const SSR_FIRST_ROUND = generateSession(() => 0.42)[0]!;
const ssrTheme = THEME_BY_KEY[SSR_FIRST_ROUND.theme];

const ssrCaption = `Look! ${
  SSR_FIRST_ROUND.left === 1 ? 'one' :
  SSR_FIRST_ROUND.left === 2 ? 'two' :
  SSR_FIRST_ROUND.left === 3 ? 'three' :
  SSR_FIRST_ROUND.left === 4 ? 'four' : String(SSR_FIRST_ROUND.left)
} ${SSR_FIRST_ROUND.left === 1 ? ssrTheme.singular : ssrTheme.plural} on this side, ${
  SSR_FIRST_ROUND.right === 1 ? 'one' :
  SSR_FIRST_ROUND.right === 2 ? 'two' :
  SSR_FIRST_ROUND.right === 3 ? 'three' :
  SSR_FIRST_ROUND.right === 4 ? 'four' : String(SSR_FIRST_ROUND.right)
} ${SSR_FIRST_ROUND.right === 1 ? ssrTheme.singular : ssrTheme.plural} on this side.`;

const TOTAL_ROUNDS = 8;
---

<StoryLayout
  title={title}
  description={description}
  themeColor="#1976d2"
  theme="comparison"
>
  <main class="mf-shell" aria-label="More Friends game">
    <header class="mf-header">
      <h1 class="mf-title">
        <span aria-hidden="true">🔍</span>
        <span>More Friends</span>
      </h1>

      <div class="mf-header-right" style="display: flex; gap: 10px; align-items: center;">
        <span
          class="mf-progress-pill"
          id="mfProgressPill"
          aria-label={`Round 1 of ${TOTAL_ROUNDS}`}
        >
          <span id="mfProgressText">1 / {TOTAL_ROUNDS}</span>
          <span class="mf-progress-bar" aria-hidden="true">
            <span class="mf-progress-fill" id="mfProgressFill"></span>
          </span>
        </span>
        <GameControls />
      </div>
    </header>

    <section
      class="mf-stage"
      id="mfStage"
      data-scene={SSR_FIRST_ROUND.theme}
      aria-label="Comparison scene"
    >
      <div
        class="mf-caption"
        id="mfCaption"
        role="status"
        aria-live="polite"
      >
        {ssrCaption}
      </div>

      <div class="mf-groups" aria-label="Which side has more friends?">
        <button
          type="button"
          class="mf-group"
          id="mfGroupLeft"
          data-side="left"
          aria-label={`Left side — ${SSR_FIRST_ROUND.left} ${
            SSR_FIRST_ROUND.left === 1 ? ssrTheme.singular : ssrTheme.plural
          } — tap if this side has more`}
        >
          {
            Array.from({ length: SSR_FIRST_ROUND.left }, (_, i) => (
              <span
                class="mf-item"
                style={`--mf-i: ${i * 0.12}s`}
                aria-hidden="true"
              >
                {ssrTheme.emoji}
              </span>
            ))
          }
        </button>

        <span class="mf-vs" aria-hidden="true">vs</span>

        <button
          type="button"
          class="mf-group"
          id="mfGroupRight"
          data-side="right"
          aria-label={`Right side — ${SSR_FIRST_ROUND.right} ${
            SSR_FIRST_ROUND.right === 1 ? ssrTheme.singular : ssrTheme.plural
          } — tap if this side has more`}
        >
          {
            Array.from({ length: SSR_FIRST_ROUND.right }, (_, i) => (
              <span
                class="mf-item"
                style={`--mf-i: ${(i + SSR_FIRST_ROUND.left) * 0.12}s`}
                aria-hidden="true"
              >
                {ssrTheme.emoji}
              </span>
            ))
          }
        </button>
      </div>
    </section>

    <footer class="mf-footer">
      <button type="button" class="mf-action" id="mfReplayBtn" aria-label="Replay this round's narration">
        🔊 Replay
      </button>
      <button type="button" class="mf-action mf-action--primary" id="mfNextBtn" aria-label="Next round" disabled>
        Next round →
      </button>
    </footer>

    <div class="mf-done" id="mfDone" role="dialog" aria-live="polite" aria-labelledby="mfDoneTitle">
      <div class="mf-done-card">
        <div class="mf-done-emoji" aria-hidden="true">🌟</div>
        <h2 class="mf-done-title" id="mfDoneTitle">More champion!</h2>
        <p class="mf-done-text" id="mfDoneText">
          You compared {TOTAL_ROUNDS} groups of friends today!
        </p>
        <div class="mf-done-actions">
          <button type="button" class="mf-action mf-action--primary" id="mfPlayAgainBtn">
            ▶ Play again
          </button>
          <a class="mf-action" href={import.meta.env.BASE_URL}>
            🏠 Home
          </a>
        </div>
      </div>
    </div>
  </main>
</StoryLayout>

<script>
  import { playTap, playCorrect } from '@/lib/audio';
  import { speak, cancelSpeech, isSpeechSupported } from '@/lib/speech';
  import { launchConfetti } from '@/lib/achievements';
  import { getSettings } from '@/lib/settings';
  import {
    generateSession,
    buildNarration,
    loadComparisonStats,
    saveComparisonStats,
    type CompRound,
    type RoundNarration,
  } from '@/data/comparison';
  import { THEME_BY_KEY, type PreschoolTheme } from '@/lib/preschool-themes';

  const TOTAL_ROUNDS = 8;
  // Confetti palette — same as Counting Friends so the two games feel
  // visually consistent on the same dev box.
  const MF_COLORS = ['#4caf50', '#1976d2', '#ffd54f', '#e91e63', '#ff7043'];

  /**
   * Read round 0 from the SSR'd DOM so the JS session starts in sync
   * with whatever Astro rendered. Avoids a synchronous DOM
   * replacement on first user interaction — without it, the very
   * first group click would race against the kickoff handler
   * mutating the groups markup. See counting-friends-game.astro for
   * the empirical proof of this race; the More Friends suite
   * inherits the fix.
   */
  const readSSRRound = (): CompRound => {
    const stageEl = document.getElementById('mfStage')!;
    const themeKey = (stageEl.dataset.scene ?? 'pond') as PreschoolTheme;
    const left = stageEl.querySelectorAll('#mfGroupLeft .mf-item').length;
    const right = stageEl.querySelectorAll('#mfGroupRight .mf-item').length;
    if (left === 0 || right === 0 || left === right) {
      // Defensive: if SSR shape ever drifts, fall back to a JS-generated
      // round so the page still works rather than throwing.
      return generateSession()[0]!;
    }
    return {
      left,
      right,
      theme: themeKey,
      bigger: left > right ? 'left' : 'right',
    };
  };

  // ── State ──────────────────────────────────────────────────────────
  let session: CompRound[] = [readSSRRound(), ...generateSession().slice(1)];
  let roundIdx = 0;
  let answered = false;
  let firstTryCorrect = false;
  let currentNarration: RoundNarration | null = null;

  // ── DOM refs ───────────────────────────────────────────────────────
  const stage = document.getElementById('mfStage') as HTMLElement;
  const captionEl = document.getElementById('mfCaption') as HTMLElement;
  const groupLeftEl = document.getElementById('mfGroupLeft') as HTMLButtonElement;
  const groupRightEl = document.getElementById('mfGroupRight') as HTMLButtonElement;
  const progressText = document.getElementById('mfProgressText') as HTMLElement;
  const progressFill = document.getElementById('mfProgressFill') as HTMLElement;
  const progressPill = document.getElementById('mfProgressPill') as HTMLElement;
  const replayBtn = document.getElementById('mfReplayBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('mfNextBtn') as HTMLButtonElement;
  const doneEl = document.getElementById('mfDone') as HTMLElement;
  const playAgainBtn = document.getElementById('mfPlayAgainBtn') as HTMLButtonElement;

  // ── Audio helpers ──────────────────────────────────────────────────

  /**
   * Speak `text` if the user has sound enabled. Same shape as
   * Counting Friends' narrate(): silent-mode setTimeout fallback,
   * watchdog alongside speechSynthesis.onend so headless CI runners
   * without a system TTS engine don't deadlock the round-progression
   * chain. See counting-friends-game.astro for the full rationale
   * for the watchdog (discovered necessary 2026-05-15 by the
   * Playwright suite).
   */
  const narrate = (text: string, opts?: { onEnd?: () => void }): void => {
    const onEnd = opts?.onEnd;
    if (!isSpeechSupported() || !getSettings().sound) {
      if (onEnd) setTimeout(onEnd, 600);
      return;
    }
    let fired = false;
    const wrap = (): void => {
      if (fired) return;
      fired = true;
      onEnd?.();
    };
    const watchdogMs = Math.max(800, text.length * 100 + 600);
    if (onEnd) setTimeout(wrap, watchdogMs);
    speak(text, { rate: 0.85, pitch: 1.15, onEnd: onEnd ? wrap : undefined });
  };

  const setCaption = (text: string): void => {
    captionEl.textContent = text;
    captionEl.style.animation = 'none';
    void captionEl.offsetWidth;
    captionEl.style.removeProperty('animation');
  };

  // ── Render helpers ─────────────────────────────────────────────────

  const itemHtml = (emoji: string, indexInGroup: number): string =>
    `<span class="mf-item" style="--mf-i: ${indexInGroup * 0.12}s" aria-hidden="true">${emoji}</span>`;

  const renderRound = (): void => {
    const round = session[roundIdx]!;
    const theme = THEME_BY_KEY[round.theme];

    progressText.textContent = `${roundIdx + 1} / ${TOTAL_ROUNDS}`;
    progressFill.style.width = `${((roundIdx + 1) / TOTAL_ROUNDS) * 100}%`;
    progressPill.setAttribute('aria-label', `Round ${roundIdx + 1} of ${TOTAL_ROUNDS}`);

    stage.dataset.scene = round.theme;

    let leftHtml = '';
    for (let i = 0; i < round.left; i++) {
      leftHtml += itemHtml(theme.emoji, i);
    }
    groupLeftEl.innerHTML = leftHtml;
    groupLeftEl.setAttribute(
      'aria-label',
      `Left side — ${round.left} ${round.left === 1 ? theme.singular : theme.plural} — tap if this side has more`,
    );
    groupLeftEl.disabled = false;
    groupLeftEl.classList.remove('mf-group--correct', 'mf-group--reveal');

    let rightHtml = '';
    for (let i = 0; i < round.right; i++) {
      rightHtml += itemHtml(theme.emoji, round.left + i);
    }
    groupRightEl.innerHTML = rightHtml;
    groupRightEl.setAttribute(
      'aria-label',
      `Right side — ${round.right} ${round.right === 1 ? theme.singular : theme.plural} — tap if this side has more`,
    );
    groupRightEl.disabled = false;
    groupRightEl.classList.remove('mf-group--correct', 'mf-group--reveal');

    answered = false;
    firstTryCorrect = false;
    currentNarration = buildNarration(round);
    nextBtn.disabled = true;
    replayBtn.disabled = false;
  };

  const speakIntroSequence = (): void => {
    const n = currentNarration;
    if (!n) return;
    const round = session[roundIdx]!;

    // Wait long enough for both fly-ins to settle before asking the
    // question. With items staggered at 0.12s and a 0.6s base, the
    // last item lands at 0.6 + (left+right-1)*0.12 ≈ ≤1.5s.
    const flyInMs = 600 + Math.max(0, round.left + round.right - 1) * 120;

    setCaption(n.intro);
    narrate(n.intro, {
      onEnd: () => {
        const wait = Math.max(150, flyInMs - 700);
        setTimeout(() => {
          setCaption(n.question);
          narrate(n.question);
        }, wait);
      },
    });
  };

  /**
   * Run a guided count of every visible item on BOTH sides, one at a
   * time, with audio narration. Used by the errorless wrong-tap
   * flow. Counts left first, then right, so the child hears the
   * sequence "one, two, three… one, two, three, four — four is more".
   */
  const speakGuidedCount = (onDone: () => void): void => {
    const allItems = [
      ...Array.from(groupLeftEl.querySelectorAll<HTMLElement>('.mf-item')),
      ...Array.from(groupRightEl.querySelectorAll<HTMLElement>('.mf-item')),
    ];
    const leftCount = groupLeftEl.querySelectorAll('.mf-item').length;
    let i = 0;

    const step = (): void => {
      if (i >= allItems.length) {
        onDone();
        return;
      }
      // Restart count when transitioning from left to right group.
      const indexInSide = i < leftCount ? i : i - leftCount;
      const item = allItems[i]!;
      item.classList.add('mf-item--counted', 'mf-item--pulse');
      setCaption(String(indexInSide + 1));
      const word =
        indexInSide + 1 === 1 ? 'one' :
        indexInSide + 1 === 2 ? 'two' :
        indexInSide + 1 === 3 ? 'three' :
        indexInSide + 1 === 4 ? 'four' : String(indexInSide + 1);
      narrate(word, {
        onEnd: () => {
          item.classList.remove('mf-item--pulse');
          i++;
          // Slightly longer pause when crossing from left to right,
          // so the child registers the side change.
          const pause = i === leftCount ? 400 : 180;
          setTimeout(step, pause);
        },
      });
    };

    step();
  };

  // ── Answer handler ─────────────────────────────────────────────────

  const onGroupTap = (side: 'left' | 'right'): void => {
    if (answered) return;
    const round = session[roundIdx]!;
    playTap();

    const tappedEl = side === 'left' ? groupLeftEl : groupRightEl;
    const correctEl = round.bigger === 'left' ? groupLeftEl : groupRightEl;

    if (side === round.bigger) {
      // Correct.
      answered = true;
      firstTryCorrect = true;
      tappedEl.classList.add('mf-group--correct');
      groupLeftEl.disabled = true;
      groupRightEl.disabled = true;
      playCorrect();
      cancelSpeech();
      const correctText = currentNarration?.correct ?? `Yes!`;
      setCaption(correctText);
      narrate(correctText);
      launchConfetti(MF_COLORS);
      bumpStats(true);
      nextBtn.disabled = false;
    } else {
      // Wrong — errorless rerun. Don't punish; run a guided count of
      // BOTH groups and then reveal the correct side. Disable both
      // groups so a second tap doesn't restart the rerun.
      answered = true;
      firstTryCorrect = false;
      groupLeftEl.disabled = true;
      groupRightEl.disabled = true;
      cancelSpeech();
      setCaption(currentNarration?.rerun ?? "Let's count them together!");
      narrate(currentNarration?.rerun ?? "Let's count them together!", {
        onEnd: () => {
          resetCountedItems();
          speakGuidedCount(() => {
            const doneText = currentNarration?.rerunDone ?? '';
            setCaption(doneText);
            narrate(doneText, {
              onEnd: () => {
                correctEl.classList.add('mf-group--reveal');
                bumpStats(false);
                nextBtn.disabled = false;
              },
            });
          });
        },
      });
    }
  };

  const resetCountedItems = (): void => {
    for (const el of stage.querySelectorAll<HTMLElement>('.mf-item--counted')) {
      el.classList.remove('mf-item--counted', 'mf-item--pulse');
    }
  };

  // ── Round progression ──────────────────────────────────────────────

  const startRound = (): void => {
    cancelSpeech();
    resetCountedItems();
    renderRound();
    requestAnimationFrame(() => speakIntroSequence());
  };

  const onNext = (): void => {
    playTap();
    if (roundIdx >= TOTAL_ROUNDS - 1) {
      showSessionComplete();
      return;
    }
    roundIdx++;
    startRound();
  };

  const showSessionComplete = (): void => {
    cancelSpeech();
    const stats = loadComparisonStats();
    saveComparisonStats({
      ...stats,
      sessions: stats.sessions + 1,
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
    doneEl.classList.add('mf-done--show');
    launchConfetti(MF_COLORS);
    narrate(`Wow! You compared ${TOTAL_ROUNDS} groups of friends today! Great job!`);
  };

  const onPlayAgain = (): void => {
    playTap();
    doneEl.classList.remove('mf-done--show');
    session = generateSession();
    roundIdx = 0;
    startRound();
  };

  // ── Stats persistence ──────────────────────────────────────────────

  const bumpStats = (correctFirstTry: boolean): void => {
    const stats = loadComparisonStats();
    saveComparisonStats({
      ...stats,
      rounds: stats.rounds + 1,
      correctFirstTry: stats.correctFirstTry + (correctFirstTry ? 1 : 0),
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
  };

  // ── Event wiring ───────────────────────────────────────────────────

  groupLeftEl.addEventListener('click', () => {
    if (!groupLeftEl.disabled) onGroupTap('left');
  });
  groupRightEl.addEventListener('click', () => {
    if (!groupRightEl.disabled) onGroupTap('right');
  });

  replayBtn.addEventListener('click', () => {
    playTap();
    cancelSpeech();
    if (!answered) {
      speakIntroSequence();
    } else {
      const text = firstTryCorrect
        ? (currentNarration?.correct ?? '')
        : (currentNarration?.rerunDone ?? '');
      setCaption(text);
      narrate(text);
    }
  });

  nextBtn.addEventListener('click', onNext);
  playAgainBtn.addEventListener('click', onPlayAgain);

  document.getElementById('btnSettings')?.addEventListener('click', () => {
    playTap();
    (window as unknown as { openSettings?: () => void }).openSettings?.();
  });

  document.getElementById('btnQuiz')?.addEventListener('click', () => {
    // No separate quiz — every round IS the quiz. Replay the
    // current round so the button feels active.
    playTap();
    cancelSpeech();
    speakIntroSequence();
  });

  document.getElementById('btnStats')?.addEventListener('click', () => {
    playTap();
    const stats = loadComparisonStats();
    const ratio =
      stats.rounds === 0
        ? 0
        : Math.round((stats.correctFirstTry / stats.rounds) * 100);
    const lines = [
      `🔍 Sessions completed: ${stats.sessions}`,
      `🌟 Rounds played: ${stats.rounds}`,
      `🎯 First-try correct: ${stats.correctFirstTry} (${ratio}%)`,
      stats.lastPlayed ? `📅 Last played: ${stats.lastPlayed}` : '📅 Last played: never',
    ];
    alert(lines.join('\n'));
  });

  // ── Initial state binding ──────────────────────────────────────────
  // The SSR'd DOM is round 0; we don't re-render it. We just bind the
  // JS state (currentNarration, header progress) so subsequent logic
  // — group clicks, replay button, etc. — has the expected
  // references.
  currentNarration = buildNarration(session[0]!);
  progressText.textContent = `1 / ${TOTAL_ROUNDS}`;
  progressFill.style.width = `${(1 / TOTAL_ROUNDS) * 100}%`;
  progressPill.setAttribute('aria-label', `Round 1 of ${TOTAL_ROUNDS}`);

  // Don't auto-speak on first paint — browsers block speechSynthesis
  // until the first user gesture. We wait for the *first* tap
  // (anywhere on the page body) to kick off the intro narration.
  // Critically, kickoff does NOT call renderRound() — that would
  // race with the click event when the user's first interaction is
  // a tap on a group. Same race that bit Counting Friends on
  // 2026-05-15 — same fix here, applied prophylactically.
  let kickedOff = false;
  const kickoff = (): void => {
    if (kickedOff) return;
    kickedOff = true;
    requestAnimationFrame(() => speakIntroSequence());
  };
  document.addEventListener('pointerdown', kickoff, { once: true });
  document.addEventListener('keydown', kickoff, { once: true });
</script>
