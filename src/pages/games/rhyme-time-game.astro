---
import StoryLayout from '@/layouts/StoryLayout.astro';
import GameControls from '@/components/GameControls.astro';
import '@/styles/rhyme-time.css';

import {
  generateSession,
  lookupWord,
  lookupFamily,
  buildNarration,
  TOTAL_ROUNDS,
} from '@/data/rhyme-time';

const title = 'Rhyme Time — Kids Learning Games';
const description =
  'A rhyming game for ages 3–4. "Cat — what rhymes with cat?" Tap the picture that rhymes, from three big cards. Ten rhyming pairs: cat/hat, dog/log, bee/tree, moon/spoon and more. Audio-first with every option read aloud, guided correction, no scoring. Second preschool literacy game, partner to Sound Friends.';

// SSR a deterministic first round so the page never paints blank. The page
// script reads round 0 straight back out of the SSR'd DOM (the Sound
// Friends / Opposites Friends kickoff-race pattern), then continues with
// random rounds 1..N once the child taps Next.
const SSR_FIRST_ROUND = generateSession(() => 0.42)[0]!;
const ssrTarget = lookupWord(SSR_FIRST_ROUND.target);
const ssrTiles = SSR_FIRST_ROUND.tiles.map((id) => lookupWord(id));
const ssrNarration = buildNarration(SSR_FIRST_ROUND);
const ssrRime = lookupFamily(ssrTarget.family).rime;
---

<StoryLayout
  title={title}
  description={description}
  themeColor="#ef476f"
  theme="rhymetime"
>
  <main class="rt-shell" aria-label="Rhyme Time game">
    <header class="rt-header">
      <h1 class="rt-title">
        <span aria-hidden="true">🎵</span>
        <span>Rhyme Time</span>
      </h1>

      <div class="rt-header-right" style="display: flex; gap: 10px; align-items: center;">
        <span
          class="rt-progress-pill"
          id="rtProgressPill"
          aria-label={`Round 1 of ${TOTAL_ROUNDS}`}
        >
          <span id="rtProgressText">1 / {TOTAL_ROUNDS}</span>
          <span class="rt-progress-bar" aria-hidden="true">
            <span class="rt-progress-fill" id="rtProgressFill"></span>
          </span>
        </span>
        <GameControls />
      </div>
    </header>

    <section
      class="rt-stage"
      id="rtStage"
      data-scene={SSR_FIRST_ROUND.theme}
      data-target={SSR_FIRST_ROUND.target}
      data-answer={SSR_FIRST_ROUND.answer}
      aria-label="Rhyme Time scene"
    >
      <button
        type="button"
        class="rt-prompt"
        id="rtPrompt"
        aria-label={`${ssrNarration.intro} Tap to hear it again.`}
      >
        <span class="rt-prompt-emoji" id="rtPromptEmoji" aria-hidden="true">
          {ssrTarget.emoji}
        </span>
        <span class="rt-prompt-text" id="rtPromptText" aria-hidden="true">
          {ssrTarget.name}
        </span>
        <span class="rt-prompt-hint" aria-hidden="true">
          what rhymes with this?
        </span>
      </button>

      <div
        class="rt-caption"
        id="rtCaption"
        role="status"
        aria-live="polite"
      >
        {ssrNarration.intro}
      </div>

      <div class="rt-tiles" aria-label="Three pictures — tap the one that rhymes">
        {
          ssrTiles.map((word, idx) => (
            <button
              type="button"
              class="rt-tile"
              id={`rtTile${idx}`}
              data-i={idx}
              data-word={word.id}
              style={`--rt-i: ${idx * 0.1}s`}
              aria-label={`Card ${idx + 1} — ${word.name}`}
            >
              <span class="rt-tile-emoji" aria-hidden="true">{word.emoji}</span>
              <span class="rt-tile-name" aria-hidden="true">{word.name}</span>
            </button>
          ))
        }
      </div>

      {/* Shown only once the answer is settled. The rime is written, never
          spoken — speech synthesis has no way to know the "ow" in bow/snow
          isn't the "ow" in cow. */}
      <div class="rt-rime-chip" id="rtRimeChip" data-rime={ssrRime} aria-hidden="true">
        <span class="rt-rime-label">both end with</span>
        <span class="rt-rime-value" id="rtRimeValue">-{ssrRime}</span>
      </div>
    </section>

    <footer class="rt-footer">
      <button type="button" class="rt-action" id="rtReplayBtn" aria-label="Hear the question again">
        🔊 Say it again
      </button>
      <button type="button" class="rt-action rt-action--primary" id="rtNextBtn" aria-label="Next round" disabled>
        Next round →
      </button>
    </footer>

    <div class="rt-done" id="rtDone" role="dialog" aria-live="polite" aria-labelledby="rtDoneTitle">
      <div class="rt-done-card">
        <div class="rt-done-emoji" aria-hidden="true">🎵</div>
        <h2 class="rt-done-title" id="rtDoneTitle">You're a rhyming star!</h2>
        <p class="rt-done-text" id="rtDoneText">
          You found {TOTAL_ROUNDS} rhymes today!
        </p>
        <div class="rt-done-actions">
          <button type="button" class="rt-action rt-action--primary" id="rtPlayAgainBtn">
            ▶ Play again
          </button>
          <a class="rt-action" href={import.meta.env.BASE_URL}>
            🏠 Home
          </a>
        </div>
      </div>
    </div>
  </main>
</StoryLayout>

<script>
  import { playTap, playCorrect, playWrong } from '@/lib/audio';
  import { speak, cancelSpeech, isSpeechSupported, onFirstGesture } from '@/lib/speech';
  import { launchConfetti } from '@/lib/achievements';
  import { getSettings } from '@/lib/settings';
  import {
    generateSession,
    buildNarration,
    lookupWord,
    lookupFamily,
    loadRhymeTimeStats,
    saveRhymeTimeStats,
    TOTAL_ROUNDS,
    type RhymeRound,
    type RhymeWordId,
    type RoundNarration,
    type PreschoolTheme,
  } from '@/data/rhyme-time';
  import { recordPlay } from '@/lib/retention';

  const GAME_ID = 'rhyme-time';
  // Pink-leaning palette shared with the literacy family (Sound Friends,
  // Letter Friends), distinct from the math green and the cognitive amber.
  const RT_COLORS = ['#ef476f', '#f78ca0', '#ffd166', '#06d6a0', '#a78bfa'];

  /**
   * Read round 0 back out of the SSR'd DOM so the JS session starts in sync
   * with whatever Astro rendered. Without this, a tap during the first
   * interaction could land on a card that has just been rewritten by a
   * freshly-randomised JS session — the kickoff race that bit Counting
   * Friends on 2026-05-15.
   */
  const readSSRRound = (): RhymeRound => {
    const stageEl = document.getElementById('rtStage');
    if (!stageEl) return generateSession()[0]!;

    const themeKey = (stageEl.dataset.scene ?? 'pond') as PreschoolTheme;
    const target = stageEl.dataset.target as RhymeWordId | undefined;
    const answer = stageEl.dataset.answer as RhymeWordId | undefined;

    const tileEls = [
      document.getElementById('rtTile0'),
      document.getElementById('rtTile1'),
      document.getElementById('rtTile2'),
    ];
    if (!target || !answer || tileEls.some((el) => !el)) {
      return generateSession()[0]!;
    }

    const tiles = tileEls.map(
      (el) => el!.dataset.word as RhymeWordId,
    ) as [RhymeWordId, RhymeWordId, RhymeWordId];
    const correctIndex = tiles.indexOf(answer);
    if (correctIndex < 0 || correctIndex > 2) {
      return generateSession()[0]!;
    }

    return {
      target,
      answer,
      tiles,
      correctIndex: correctIndex as 0 | 1 | 2,
      // `tier` isn't used by the controller; 0 is a safe placeholder for
      // the SSR-derived round.
      tier: 0,
      theme: themeKey,
    };
  };

  // ── State ──────────────────────────────────────────────────────────
  let session: RhymeRound[] = [readSSRRound(), ...generateSession().slice(1)];
  let roundIdx = 0;
  let answered = false;
  let currentNarration: RoundNarration | null = null;
  /** Most recent post-answer phrase, cached so Replay re-narrates it. */
  let lastPostAnswerText = '';

  // ── DOM refs ───────────────────────────────────────────────────────
  const stage = document.getElementById('rtStage') as HTMLElement;
  const promptEl = document.getElementById('rtPrompt') as HTMLButtonElement;
  const promptEmoji = document.getElementById('rtPromptEmoji') as HTMLElement;
  const promptText = document.getElementById('rtPromptText') as HTMLElement;
  const captionEl = document.getElementById('rtCaption') as HTMLElement;
  const rimeChip = document.getElementById('rtRimeChip') as HTMLElement;
  const rimeValue = document.getElementById('rtRimeValue') as HTMLElement;
  const tileEls = [
    document.getElementById('rtTile0') as HTMLButtonElement,
    document.getElementById('rtTile1') as HTMLButtonElement,
    document.getElementById('rtTile2') as HTMLButtonElement,
  ];
  const progressText = document.getElementById('rtProgressText') as HTMLElement;
  const progressFill = document.getElementById('rtProgressFill') as HTMLElement;
  const progressPill = document.getElementById('rtProgressPill') as HTMLElement;
  const replayBtn = document.getElementById('rtReplayBtn') as HTMLButtonElement;
  const nextBtn = document.getElementById('rtNextBtn') as HTMLButtonElement;
  const doneEl = document.getElementById('rtDone') as HTMLElement;
  const playAgainBtn = document.getElementById('rtPlayAgainBtn') as HTMLButtonElement;

  // ── Audio helpers ──────────────────────────────────────────────────

  /**
   * Speak `text` if the user has sound enabled. Same shape as the rest of
   * the preschool family: silent-mode setTimeout fallback + watchdog
   * alongside speechSynthesis.onend, so headless CI runners without a TTS
   * engine don't deadlock the round-progression chain.
   */
  const narrate = (text: string, opts?: { onEnd?: () => void }): void => {
    const onEnd = opts?.onEnd;
    if (!isSpeechSupported() || !getSettings().sound) {
      if (onEnd) setTimeout(onEnd, 600);
      return;
    }
    let fired = false;
    const wrap = (): void => {
      if (fired) return;
      fired = true;
      onEnd?.();
    };
    const watchdogMs = Math.max(800, text.length * 100 + 600);
    if (onEnd) setTimeout(wrap, watchdogMs);
    speak(text, { rate: 0.85, pitch: 1.15, onEnd: onEnd ? wrap : undefined });
  };

  const setCaption = (text: string): void => {
    captionEl.textContent = text;
    captionEl.style.animation = 'none';
    void captionEl.offsetWidth;
    captionEl.style.removeProperty('animation');
  };

  /** Reveal the written rime once the round is settled either way. */
  const showRime = (): void => {
    rimeChip.classList.add('rt-rime-chip--show');
  };

  // ── Render helpers ─────────────────────────────────────────────────

  const renderRound = (): void => {
    const round = session[roundIdx]!;
    const narration = buildNarration(round);
    const target = lookupWord(round.target);
    const family = lookupFamily(target.family);

    progressText.textContent = `${roundIdx + 1} / ${TOTAL_ROUNDS}`;
    progressFill.style.width = `${((roundIdx + 1) / TOTAL_ROUNDS) * 100}%`;
    progressPill.setAttribute('aria-label', `Round ${roundIdx + 1} of ${TOTAL_ROUNDS}`);

    stage.dataset.scene = round.theme;
    stage.dataset.target = round.target;
    stage.dataset.answer = round.answer;

    promptEmoji.textContent = target.emoji;
    promptText.textContent = target.name;
    promptEl.setAttribute('aria-label', `${narration.intro} Tap to hear it again.`);

    rimeChip.classList.remove('rt-rime-chip--show');
    rimeChip.dataset.rime = family.rime;
    rimeValue.textContent = `-${family.rime}`;

    for (let g = 0; g < 3; g++) {
      const word = lookupWord(round.tiles[g]!);
      const el = tileEls[g]!;
      el.dataset.word = word.id;
      el.style.setProperty('--rt-i', `${g * 0.1}s`);
      el.setAttribute('aria-label', `Card ${g + 1} — ${word.name}`);
      el.innerHTML =
        `<span class="rt-tile-emoji" aria-hidden="true">${word.emoji}</span>` +
        `<span class="rt-tile-name" aria-hidden="true">${word.name}</span>`;
      el.disabled = false;
      el.classList.remove('rt-tile--correct', 'rt-tile--reveal', 'rt-tile--wrong');
      // Force re-trigger of the fly-in animation on each render.
      el.style.animation = 'none';
      void el.offsetWidth;
      el.style.removeProperty('animation');
    }

    answered = false;
    currentNarration = narration;
    lastPostAnswerText = '';
    nextBtn.disabled = true;
    replayBtn.disabled = false;
  };

  const speakIntro = (): void => {
    const intro = currentNarration?.intro;
    if (!intro) return;
    setCaption(intro);
    narrate(intro);
  };

  // ── Answer handler ─────────────────────────────────────────────────

  const onTileTap = (idx: 0 | 1 | 2): void => {
    if (answered) return;
    const round = session[roundIdx]!;
    playTap();

    const tappedEl = tileEls[idx]!;
    const correctEl = tileEls[round.correctIndex]!;
    const tappedWord = round.tiles[idx]!;

    if (idx === round.correctIndex) {
      // Correct — celebrate, then speak the deck's rhyming sentence.
      answered = true;
      tappedEl.classList.add('rt-tile--correct');
      for (const el of tileEls) el.disabled = true;
      playCorrect();
      cancelSpeech();
      const correctText = currentNarration?.correct ?? 'Yes!';
      lastPostAnswerText = correctText;
      setCaption(correctText);
      narrate(correctText);
      showRime();
      launchConfetti(RT_COLORS);
      bumpStats(true);
      nextBtn.disabled = false;
    } else {
      // Wrong — guided correction. Sequence:
      //   1) error tone + 250ms shake + red tint on the tapped card
      //      (feedback rule revised 2026-08-17).
      //   2) "Hmm! Let's listen again."                    (rerun)
      //   3) "cat and dog end with different sounds."      (wrongIs)
      //   4) "Listen — cat, hat. They sound the same!"     (reveal)
      //   5) Enable Next. Still no score, still no failed round.
      answered = true;
      for (const el of tileEls) el.disabled = true;
      tappedEl.classList.add('rt-tile--wrong');
      playWrong();
      cancelSpeech();
      const rerunText = currentNarration?.rerun ?? "Let's listen again.";
      setCaption(rerunText);
      narrate(rerunText, {
        onEnd: () => {
          const wrongText =
            currentNarration?.wrongIs(tappedWord) ??
            `That one is ${lookupWord(tappedWord).name.toLowerCase()}.`;
          setCaption(wrongText);
          lastPostAnswerText = wrongText;
          narrate(wrongText, {
            onEnd: () => {
              // Brief pause so the child registers the shift from "that
              // one" to "this one".
              setTimeout(() => {
                const revealText =
                  currentNarration?.reveal ??
                  `${lookupWord(round.target).name} rhymes with ${lookupWord(round.answer).name}.`;
                setCaption(revealText);
                lastPostAnswerText = revealText;
                correctEl.classList.add('rt-tile--reveal');
                showRime();
                narrate(revealText, {
                  onEnd: () => {
                    bumpStats(false);
                    nextBtn.disabled = false;
                  },
                });
              }, 350);
            },
          });
        },
      });
    }
  };

  // ── Round progression ──────────────────────────────────────────────

  const startRound = (): void => {
    cancelSpeech();
    renderRound();
    requestAnimationFrame(() => speakIntro());
  };

  const onNext = (): void => {
    playTap();
    if (roundIdx >= TOTAL_ROUNDS - 1) {
      showSessionComplete();
      return;
    }
    roundIdx++;
    startRound();
  };

  const showSessionComplete = (): void => {
    cancelSpeech();
    const stats = loadRhymeTimeStats();
    saveRhymeTimeStats({
      ...stats,
      sessions: stats.sessions + 1,
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
    recordPlay(GAME_ID);
    doneEl.classList.add('rt-done--show');
    launchConfetti(RT_COLORS);
    narrate(`Wow! You found ${TOTAL_ROUNDS} rhymes today! Great listening!`);
  };

  const onPlayAgain = (): void => {
    playTap();
    doneEl.classList.remove('rt-done--show');
    session = generateSession();
    roundIdx = 0;
    startRound();
  };

  // ── Stats persistence ──────────────────────────────────────────────

  const bumpStats = (correctFirstTry: boolean): void => {
    const stats = loadRhymeTimeStats();
    saveRhymeTimeStats({
      ...stats,
      rounds: stats.rounds + 1,
      correctFirstTry: stats.correctFirstTry + (correctFirstTry ? 1 : 0),
      lastPlayed: new Date().toISOString().slice(0, 10),
    });
    recordPlay(GAME_ID);
  };

  // ── Event wiring ───────────────────────────────────────────────────

  for (const el of tileEls) {
    el.addEventListener('click', () => {
      if (el.disabled) return;
      const idx = Number(el.dataset.i);
      if (idx === 0 || idx === 1 || idx === 2) {
        onTileTap(idx as 0 | 1 | 2);
      }
    });
  }

  /**
   * Replay handler shared by the prompt card and the Replay button.
   *
   * Before an answer this repeats the question *including the three
   * options* — this is an audio-first game, so a child who lost one of the
   * words has no way to recover it from the screen. After an answer it
   * re-narrates the last phrase instead.
   */
  const onReplay = (): void => {
    playTap();
    cancelSpeech();
    if (!answered) {
      speakIntro();
      return;
    }
    const text = lastPostAnswerText || (currentNarration?.intro ?? '');
    setCaption(text);
    narrate(text);
  };

  promptEl.addEventListener('click', onReplay);
  replayBtn.addEventListener('click', onReplay);

  nextBtn.addEventListener('click', onNext);
  playAgainBtn.addEventListener('click', onPlayAgain);

  document.getElementById('btnSettings')?.addEventListener('click', () => {
    playTap();
    (window as unknown as { openSettings?: () => void }).openSettings?.();
  });

  document.getElementById('btnQuiz')?.addEventListener('click', () => {
    playTap();
    cancelSpeech();
    speakIntro();
  });

  document.getElementById('btnStats')?.addEventListener('click', () => {
    playTap();
    const stats = loadRhymeTimeStats();
    const ratio =
      stats.rounds === 0
        ? 0
        : Math.round((stats.correctFirstTry / stats.rounds) * 100);
    const lines = [
      `🎵 Sessions completed: ${stats.sessions}`,
      `🌟 Rounds played: ${stats.rounds}`,
      `🎯 First-try correct: ${stats.correctFirstTry} (${ratio}%)`,
      stats.lastPlayed ? `📅 Last played: ${stats.lastPlayed}` : '📅 Last played: never',
    ];
    alert(lines.join('\n'));
  });

  // ── Initial state binding ──────────────────────────────────────────
  // The SSR'd DOM is round 0; we don't re-render it. Bind JS state so
  // subsequent logic — tile clicks, replay, etc. — has the references.
  currentNarration = buildNarration(session[0]!);
  progressText.textContent = `1 / ${TOTAL_ROUNDS}`;
  progressFill.style.width = `${(1 / TOTAL_ROUNDS) * 100}%`;
  progressPill.setAttribute('aria-label', `Round 1 of ${TOTAL_ROUNDS}`);

  // Speech is blocked until the first gesture, so the intro waits for it.
  // Deliberately does NOT call renderRound() — that would race with a
  // first-interaction tap on a tile.
  onFirstGesture(() => speakIntro());
</script>
